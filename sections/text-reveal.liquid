{% comment %}
  Lines of type standing around a 3D cylinder, turned by scroll position —
  each one rises, faces the viewer, and rolls away over the top.

  The section is taller than the viewport and its frame is sticky, so the
  turn is scrubbed across that extra height rather than played once on
  entry. "Scroll distance" is what that height is.

  Built natively rather than on ScrollTrigger: this theme scrolls
  `.page-wrapper` above 990px and the document below it, so a scroll-linked
  library would need its scroller reconfigured on every breakpoint change.
  Reading the section's own viewport rect avoids the question — a rect is
  measured against the viewport whichever element is doing the scrolling.
{% endcomment %}

{% liquid
  assign font = section.settings.font | default: 'heading'
  assign gap = section.settings.gap
  assign lines = section.settings.items | newline_to_br | split: '<br />'
%}

<text-reveal
  class="text-reveal"
  data-gap="{{ gap }}"
  data-start-rotation="{{ section.settings.start_rotation }}"
  data-end-rotation="{{ section.settings.end_rotation }}"
  style="
    --reveal-background: {{ section.settings.background_color }};
    --reveal-text: {{ section.settings.text_color }};
    --reveal-font: var(--font-{{ font }}--family);
    --reveal-weight: var(--font-{{ font }}--weight);
    --reveal-perspective: {{ section.settings.perspective }}px;
    --reveal-scroll-distance: {{ section.settings.scroll_distance }}svh;
    --reveal-rows: {{ section.settings.lines_rows }};
    --reveal-content-gap: {{ section.settings.content_gap }}px;
    --reveal-intro-width: {{ section.settings.intro_width }}rem;
  "
>
  <div class="text-reveal__viewport">
    <div class="text-reveal__content">
      {%- comment -%}
        Reserves the height the turning lines sweep through, so the
        paragraph below is never swung over. The script measures it — it
        follows from the cylinder's radius and the angle of the last line.
      {%- endcomment -%}
      <div class="text-reveal__sweep">
        <div
          class="text-reveal__drum"
          ref="drum"
        >
      {% assign index = 0 %}
      {% for line in lines %}
        {% assign trimmed = line | strip %}
        {% if trimmed == blank %}
          {% continue %}
        {% endif %}

        {%- comment -%}
          Negative, so the drum turning forwards brings the lines round in
          the order they're written rather than back to front.
        {%- endcomment -%}
        {% assign angle = index | times: gap | times: -1 %}

        <div
          class="text-reveal__item"
          style="--item-angle: {{ angle }}deg;"
        >
          {{ trimmed }}
        </div>

          {% assign index = index | plus: 1 %}
        {% endfor %}
        </div>
      </div>

      {% if section.settings.intro != blank %}
        {%- comment -%}
          Resolves in as the last line rolls away, so the turn ends on a
          statement rather than on an empty cylinder — and the scroll after
          the lines have gone is doing something.
        {%- endcomment -%}
        <div
          class="text-reveal__intro"
          ref="intro"
        >
          {{ section.settings.intro }}
        </div>
      {% endif %}
    </div>
  </div>
</text-reveal>

<script
  src="{{ 'text-reveal.js' | asset_url }}"
  type="module"
></script>

{% stylesheet %}
  .text-reveal {
    display: block;
    position: relative;
    height: var(--reveal-scroll-distance, 300svh);
    background-color: var(--reveal-background, var(--color-background));
    color: var(--reveal-text, var(--color-foreground));
  }

  .text-reveal__viewport {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    place-items: center;
    padding-inline: var(--ocp-page-margin);

    /* The cylinder is wider than the viewport at its edges; without this the
       lines swinging away would widen the page. */
    overflow: clip;
  }

  .text-reveal__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--reveal-content-gap, 2rem);
    width: 100%;
  }

  /* The lines swing well above and below the drum's own one-line box, so
     the paragraph gets the sweep's full height reserved beneath it rather
     than being written over. --reveal-sweep is measured by the script; the
     fallback only has to be sane for the moment before it runs. */
  /*
   * The window the drum turns inside. Its height is stated in lines rather
   * than worked out from the cylinder, so what the section occupies is what
   * the editor asked for and nothing reserves space invisibly.
   *
   * `perspective` belongs here, on the drum's direct parent — it applies to
   * an element's own children, so left further up it does nothing at all and
   * the lines collapse into a flat stack.
   */
  .text-reveal__sweep {
    display: grid;
    place-items: center;
    width: 100%;

    /* The display size. Its own vw term already keeps the lines, which
       never wrap, inside a narrow screen. */
    font-size: var(--ocp-display-size);
    line-height: 1.15;
    min-height: calc(var(--reveal-rows, 2.5) * 1.15em);

    perspective: var(--reveal-perspective, 1000px);

    /* Lines turning past the window are cut at its edge rather than allowed
       to run into the paragraph below. */
    overflow: clip;
  }

  .text-reveal__intro {
    max-width: var(--reveal-intro-width, 42rem);
    text-align: center;
    font-family: var(--font-body--family);
    font-size: var(--ocp-text-size);
    line-height: 1.5;
    text-wrap: pretty;

    /* Written by the script as the turn ends. Full by default, so the
       paragraph is simply there if the module never runs. */
    opacity: var(--reveal-intro-opacity, 1);
  }

  .text-reveal__intro > :first-child {
    margin-block-start: 0;
  }

  .text-reveal__intro > :last-child {
    margin-block-end: 0;
  }

  .text-reveal__drum {
    position: relative;
    width: 100%;

    /* The drum is one line tall — every line is stacked on it and pushed out
       to the cylinder's surface, so this height is what sets the radius. */
    height: 1.15em;

    font-family: var(--reveal-font);
    font-weight: 700;
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
    text-align: center;

    transform-style: preserve-3d;
    transform: rotateX(var(--reveal-rotation, 0deg));
    will-change: transform;
  }

  .text-reveal__item {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    white-space: nowrap;

    transform: rotateX(var(--item-angle, 0deg)) translateZ(var(--reveal-radius, 0px));

    /* Lines on the far side of the drum would otherwise show through it,
       mirrored. */
    backface-visibility: hidden;
  }

  /*
   * Without the module the radius is never measured, so every line would sit
   * stacked on the axis on top of the others. Reduced motion has no business
   * turning a drum either. Both fall back to the lines simply set out one
   * under another.
   */
  @media (prefers-reduced-motion: reduce) {
    .text-reveal,
    .text-reveal:not(:defined) {
      height: auto;
    }
  }

  text-reveal:not(:defined) {
    height: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .text-reveal .text-reveal__viewport {
      position: static;
      height: auto;
      padding-block: clamp(4rem, 12vh, 8rem);
      perspective: none;
    }

    .text-reveal .text-reveal__sweep {
      min-height: 0;
      perspective: none;
      overflow: visible;
    }

    .text-reveal .text-reveal__drum {
      height: auto;
      display: flex;
      flex-direction: column;
      gap: 0.1em;
      transform: none;
      transform-style: flat;
    }

    .text-reveal .text-reveal__item {
      position: static;
      transform: none;
    }
  }

  text-reveal:not(:defined) .text-reveal__viewport {
    position: static;
    height: auto;
    padding-block: clamp(4rem, 12vh, 8rem);
    perspective: none;
  }

  text-reveal:not(:defined) .text-reveal__sweep {
    min-height: 0;
    perspective: none;
    overflow: visible;
  }

  text-reveal:not(:defined) .text-reveal__drum {
    height: auto;
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    transform: none;
    transform-style: flat;
  }

  text-reveal:not(:defined) .text-reveal__item {
    position: static;
    transform: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "3D text reveal",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "items",
      "label": "Lines",
      "info": "One per line. Each gets its own place on the cylinder, so keep them short enough not to wrap.",
      "default": "No side menu\nNo distractions\nJust coffee\nFrom the world's\nBest roasters"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Paragraph",
      "info": "Sits under the lines and resolves in as the last of them rolls away."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0f80be"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "font",
      "label": "Font",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "heading", "label": "Heading" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "heading"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "lines_rows",
      "label": "Height of the lines area",
      "info": "In lines. At 1 only the line facing you shows; higher leaves room for the ones turning past it, and anything beyond is cut off at the edge.",
      "min": 1,
      "max": 6,
      "step": 0.5,
      "default": 2.5
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Space below the lines",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "intro_width",
      "label": "Paragraph width",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "rem",
      "default": 42
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Angle between lines",
      "info": "Wider spacing puts the lines further apart on a larger cylinder, so each one holds the front for longer.",
      "min": 5,
      "max": 40,
      "step": 1,
      "unit": "°",
      "default": 15
    },
    {
      "type": "range",
      "id": "start_rotation",
      "label": "Start angle",
      "info": "How far below the front the first line begins. Most of the scroll is spent on whatever this and the end angle add beyond the lines' own span, so keep both close to it.",
      "min": -180,
      "max": 0,
      "step": 5,
      "default": -30
    },
    {
      "type": "range",
      "id": "end_rotation",
      "label": "End angle",
      "info": "Set this a little past the last line's own angle — lines multiplied by the angle between them — or the drum either stops before they have all gone by, or spends the rest of the scroll turning through nothing.",
      "min": 0,
      "max": 360,
      "step": 5,
      "default": 75
    },
    {
      "type": "range",
      "id": "perspective",
      "label": "Perspective",
      "info": "Lower is a stronger sense of depth.",
      "min": 400,
      "max": 2000,
      "step": 100,
      "unit": "px",
      "default": 1000
    },
    {
      "type": "range",
      "id": "scroll_distance",
      "label": "Scroll distance",
      "info": "The section's height, as a share of the screen. The turn is spread across the whole of it, beginning as the section comes into view. At 100% the turn finishes exactly as the section lands; anything above that is held in place at the end.",
      "min": 100,
      "max": 500,
      "step": 10,
      "unit": "%",
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "3D text reveal"
    }
  ]
}
{% endschema %}
