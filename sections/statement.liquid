{% comment %}
  A panel that rises into the viewport carrying one paragraph, which fills
  in word by word as the scroll carries on — dim ahead of the reading, full
  behind it.

  statement.js writes each beat out as a number between 0 and 1 and decides
  nothing about appearance. What the stylesheet describes with no script
  running — panel up, every word filled — is the readable composition, so
  the paragraph is never left half-legible.
{% endcomment %}

{% liquid
  assign font = section.settings.font | default: 'heading'
  assign words = section.settings.text | strip | split: ' '
%}

<scroll-statement
  class="statement"
  style="
    --statement-background: {{ section.settings.background_color }};
    --statement-text: {{ section.settings.text_color }};
    --statement-font: var(--font-{{ font }}--family);
    --statement-distance: {{ section.settings.scroll_distance }}svh;
    --statement-dim: {{ section.settings.dim | divided_by: 100.0 }};
    --statement-width: {{ section.settings.max_width }}rem;
    --statement-overlap: {{ section.settings.overlap }}svh;
    --statement-products-width: {{ section.settings.products_width }}rem;
  "
>
  <div class="statement__viewport">
    {%- comment -%}
      The paragraph sits on the panel rather than beside it, so the white
      block and its words rise as one thing. Held off it, the words would be
      legible over the section behind before the white had arrived under
      them.

      Split to words so the fill can run across the paragraph. Each carries
      its own trailing space inside the span, so lines break where they
      would have anyway.
    {%- endcomment -%}
    <div class="statement__panel">
      <p class="statement__text">
        {%- for word in words -%}
          {%- if word != blank -%}
            <span
              class="statement__word"
              data-word
            >{{ word }} </span>
          {%- endif -%}
        {%- endfor -%}
      </p>

      {%- comment -%}
        The products run up the right-hand side, rendered through the theme's
        own product card rather than a second one written here, so they keep
        the hover strip, the quick add and everything else those carry.

        The track is taken out of flow so its height cannot stretch the panel:
        it is far taller than the screen on purpose, and the sticky frame is
        what hides the part that has not arrived yet. Nothing clips the column
        itself — it simply starts below the fold and is carried up.

        With no collection chosen it falls back to placeholder cards rather
        than disappearing, so a half-configured section looks unfinished
        instead of losing a third of its layout.
      {%- endcomment -%}
      <div
        class="statement__products"
        ref="column"
      >
        <div
          class="statement__track"
          ref="track"
        >
          {% if section.settings.collection != blank and shop.products_count != 0 %}
            {% paginate section.settings.collection.products by section.settings.max_products %}
              {% for product in section.settings.collection.products limit: section.settings.max_products %}
                <div class="statement__product">
                  {% content_for 'block',
                    type: '_product-card',
                    id: 'static-product-card',
                    closest.product: product,
                    product_view_context: 'collection'
                  %}
                </div>
              {% endfor %}
            {% endpaginate %}
          {% else %}
            {% for i in (1..section.settings.max_products) %}
              <div class="statement__product">
                {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</scroll-statement>

<script
  src="{{ 'statement.js' | asset_url }}"
  type="module"
></script>

{% stylesheet %}
  .statement {
    display: block;
    position: relative;

    /* The read and the column are scrolled one after the other, so the
       section has to be long enough for both. statement.js measures how far
       the column has to travel and writes it here; the travel maps 1:1 onto
       scroll, so a card moves a pixel for a pixel. */
    height: calc(var(--statement-distance, 180svh) + var(--products-travel, 0px));

    /* Pulled up into the hold at the end of the section above, so the block
       rises while that section's frame is still pinned — the picture behind
       stays put and this slides over it. Without the overlap this would
       begin exactly as that frame let go, and the two would move together
       rather than one over the other. */
    margin-block-start: calc(var(--statement-overlap, 0svh) * -1);
  }

  /*
   * The panel rises over whatever precedes it, so this section's wrapper is
   * left see-through. The hero's stacking rule paints every section after it
   * opaque so the pinned hero cannot show through; here the rise is the
   * point, and the first selector repeats the hero's to outweigh it.
   */
  .shopify-section:has(.hero-video[data-stack]) ~ .shopify-section:has(.statement),
  .shopify-section:has(.statement) {
    background-color: transparent;
  }

  .statement__viewport {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: clip;
  }

  /* The white block itself: background and paragraph together, rising from
     below the fold as one. */
  .statement__panel {
    position: absolute;
    inset: 0;

    /* The paragraph on the left, the products running up the right. */
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--statement-products-width, 20rem));
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    align-content: center;
    padding-inline: var(--ocp-page-margin);
    padding-block: var(--ocp-page-margin);
    background-color: var(--statement-background, var(--color-background));
    transform: translateY(calc((1 - var(--panel, 1)) * 100%));
    will-change: transform;
  }

  .statement__text {
    margin: 0;
    max-width: var(--statement-width, 46rem);

    font-family: var(--statement-font);
    font-weight: 700;

    /* The middle step of the site's three sizes. */
    font-size: var(--ocp-display-size-sm);
    line-height: 1.15;
    letter-spacing: var(--ocp-letter-spacing);
    text-wrap: pretty;
    color: var(--statement-text, var(--color-foreground));
  }

  /* Dim ahead of the reading and full behind it. Opacity rather than a
     second colour, so it works against any panel colour without a second
     setting to keep in step. */
  .statement__products {
    position: relative;
    align-self: stretch;
    min-width: 0;

    /* The cards read against the panel, not against the page's colour
       scheme — otherwise their titles and prices come out in the brand blue
       over white. Reuses the section's own text colour rather than adding a
       second setting that could drift away from it. */
    --color-foreground: var(--statement-text, #111111);
    color: var(--statement-text, #111111);
  }

  /*
   * Out of flow, so a column far taller than the screen cannot stretch the
   * panel it sits in. Nothing clips it: it begins below the fold and the
   * sticky frame is what hides the rest.
   */
  .statement__track {
    position: absolute;
    inset-inline: 0;
    top: 0;

    display: flex;
    flex-direction: column;
    gap: var(--statement-track-gap, 1.5rem);

    transform: translate3d(0, var(--products-offset, 0px), 0);
    will-change: transform;
  }

  .statement__word {
    opacity: calc(var(--statement-dim, 0.22) + var(--fill, 1) * (1 - var(--statement-dim, 0.22)));
  }

  /* One column below the breakpoint: side by side there is not enough width
     for a readable paragraph and a card, so the products fall under it and
     the column stops travelling — the page's own scroll carries them. */
  /*
   * Narrow, the column turns on its side: paragraph above, cards running off
   * the right edge as a strip you swipe. A tall column beside a readable line
   * does not fit, and a tall column stacked under one would need a second
   * screen of scroll to get past — turning it flat costs neither.
   */
  @media screen and (max-width: 989px) {
    /* No column to carry means no extra length to carry it through, and the
       page's own scroll is the only movement the strip needs. */
    .statement.statement {
      height: var(--statement-distance, 180svh);
    }

    .statement .statement__panel {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: min-content;
      gap: clamp(1.5rem, 4vh, 2.5rem);
      align-content: center;
    }

    .statement .statement__products {
      align-self: start;

      /* Out through the panel's gutter, so the strip runs to the screen edge
         and the card at the end is visibly cut rather than sitting in a box
         with room to spare. */
      margin-inline: calc(var(--ocp-page-margin) * -1);
    }

    .statement .statement__track {
      position: static;
      transform: none;

      flex-direction: row;
      gap: 1rem;

      /* The gutter comes back as padding, so the first card lines up with
         the paragraph above it while the strip itself is full width. */
      padding-inline: var(--ocp-page-margin);

      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: x proximity;

      /* A scrollbar under the cards reads as a second page scroll. */
      scrollbar-width: none;
    }

    .statement .statement__track::-webkit-scrollbar {
      display: none;
    }

    .statement .statement__product {
      flex: 0 0 var(--statement-card-width, min(56vw, 16rem));
      scroll-snap-align: start;
    }

    /*
     * The panel is one screen and holds the paragraph too, so a portrait
     * card sized purely off its own width can push the pair past the bottom
     * on a short phone. Capping the image against the viewport crops it
     * instead — the card keeps its width and the paragraph keeps its room.
     */
    .statement .statement__product .card-gallery {
      max-height: 40svh;
    }
  }

  /*
   * Nothing writes those numbers without the script, so the defaults stand:
   * the panel up and every word filled. The section has no scroll to drive
   * it either, so it collapses to one screen rather than leaving more of
   * empty colour below.
   */
  scroll-statement:not([data-driven]) {
    height: auto;
  }

  scroll-statement:not([data-driven]) .statement__viewport {
    position: static;
    height: auto;
  }

  scroll-statement:not([data-driven]) .statement__panel {
    position: static;
    padding-block: clamp(4rem, 14vh, 9rem);

    /* Nothing is going to carry the column past anybody, so it reads as a
       list under the paragraph rather than a strip beside it. */
    grid-template-columns: minmax(0, 1fr);
  }

  scroll-statement:not([data-driven]) .statement__track {
    position: static;
    transform: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Statement",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph",
      "info": "Fills in word by word as the section is scrolled.",
      "default": "We don't roast. We choose. Every week we taste through what other roasters have made, here and half a world away, and only what earns it reaches the shelf."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Runs up the right-hand side as the paragraph is read."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "How many",
      "info": "They are scrolled through one after another, so ten is the most that stays worth the scroll.",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "products_width",
      "label": "Column width",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "rem",
      "default": 20
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Panel",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "select",
      "id": "font",
      "label": "Font",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "heading", "label": "Heading" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "heading"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Paragraph width",
      "min": 20,
      "max": 70,
      "step": 2,
      "unit": "rem",
      "default": 46
    },
    {
      "type": "range",
      "id": "dim",
      "label": "Unread text",
      "info": "How visible a word is before the fill reaches it.",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "%",
      "default": 22
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "range",
      "id": "overlap",
      "label": "Overlap the section above",
      "info": "Rises into the section above rather than after it, so whatever is pinned there stays put while this slides over it. Match it to that section's hold.",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "scroll_distance",
      "label": "Scroll distance",
      "info": "The section's height, as a share of the screen. The rise and the fill are spread across it.",
      "min": 120,
      "max": 400,
      "step": 10,
      "unit": "%",
      "default": 180
    }
  ],
  "presets": [
    {
      "name": "Statement"
    }
  ]
}
{% endschema %}
