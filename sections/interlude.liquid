{% comment %}
  A held beat between two sections: a plain colour panel that rises over
  whatever is behind it, carries one line, and holds before letting the page
  go.

  Deliberately the only scroll section here with no effect on its type. The
  statement above it fills word by word and the locations before that stagger
  and split; a third animated line in a row stops reading as emphasis and
  starts reading as a habit. The rise is the whole motion, and the stillness
  is what makes the line land.
{% endcomment %}

{% liquid
  assign font = section.settings.font | default: 'heading'

  # The small step is named --ocp-display-size-sm, not --ocp-display-sm-size,
  # so the suffix goes on the end rather than interpolating into the middle.
  assign size_token = '--ocp-display-size'
  if section.settings.text_size == 'display-sm'
    assign size_token = '--ocp-display-size-sm'
  endif
%}

<scroll-rise
  class="interlude"
  style="
    --interlude-background: {{ section.settings.background_color }};
    --interlude-text: {{ section.settings.text_color }};
    --interlude-font: var(--font-{{ font }}--family);
    --interlude-size: var({{ size_token }});
    --interlude-distance: {{ section.settings.scroll_distance }}lvh;
    --interlude-overlap: {{ section.settings.overlap }}lvh;
    --interlude-tail: {{ section.settings.tail }}lvh;
    --rise-tail-units: {{ section.settings.tail }};
  "
>
  <div
    class="interlude__viewport"
    ref="frame"
  >
    <div class="interlude__panel">
      {% if section.settings.heading != blank %}
        <p class="interlude__heading">{{ section.settings.heading }}</p>
      {% endif %}

      {% if section.settings.sub != blank %}
        <p class="interlude__sub">{{ section.settings.sub }}</p>
      {% endif %}
    </div>
  </div>
</scroll-rise>

<script
  src="{{ 'scroll-rise.js' | asset_url }}"
  type="module"
></script>

{% stylesheet %}
  .interlude {
    display: block;
    position: relative;
    height: calc(var(--interlude-distance, 140lvh) + var(--interlude-tail, 0lvh));

    /* Pulled up into the pause at the end of the section above, so this rises
       while that section's frame is still pinned — what is behind stays put
       and this slides over it. Without the overlap the two would move
       together rather than one over the other. */
    margin-block-start: calc(var(--interlude-overlap, 0lvh) * -1);
  }

  /*
   * The panel rises over what precedes it, so this section's wrapper is left
   * see-through. The hero's stacking rule paints every section after it
   * opaque so the pinned hero cannot show through; here the rise is the
   * point, and the first selector repeats the hero's to outweigh it.
   */
  .shopify-section:has(.hero-video[data-stack]) ~ .shopify-section:has(.interlude),
  .shopify-section:has(.interlude) {
    background-color: transparent;
  }

  .interlude__viewport {
    position: sticky;
    top: 0;
    height: 100lvh;
    overflow: clip;
  }

  .interlude__panel {
    position: absolute;
    inset: 0;

    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;

    padding-inline: var(--ocp-page-margin);
    padding-block: var(--ocp-page-margin);

    background-color: var(--interlude-background, var(--color-foreground));
    transform: translateY(calc((1 - var(--rise, 1)) * 100%));
    will-change: transform;
  }

  .interlude__heading {
    margin: 0;
    max-width: 18ch;

    font-family: var(--interlude-font);
    font-weight: 700;
    font-size: var(--interlude-size, var(--ocp-display-size));
    line-height: var(--ocp-leading-display);
    letter-spacing: var(--ocp-letter-spacing);
    text-wrap: balance;
    color: var(--interlude-text, var(--color-background));
  }

  .interlude__sub {
    margin: 0;
    max-width: 44ch;

    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: var(--ocp-text-size);
    line-height: var(--ocp-leading-snug);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
    color: var(--interlude-text, var(--color-background));
  }

  /*
   * Nothing writes the number without the script, so the default stands: the
   * panel up, the line on it. There is no scroll driving it either, so it
   * collapses to one screen rather than leaving more of empty colour below.
   */
  scroll-rise:not([data-driven]) {
    height: auto;
  }

  scroll-rise:not([data-driven]) .interlude__viewport {
    position: static;
    height: auto;
  }

  scroll-rise:not([data-driven]) .interlude__panel {
    position: static;
    padding-block: clamp(4rem, 14vh, 9rem);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Interlude",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Line",
      "default": "Don't know what to pick?"
    },
    {
      "type": "text",
      "id": "sub",
      "label": "Line under it",
      "default": "Good. That's the whole point of us."
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Line size",
      "info": "The site's two display sizes. There is no third.",
      "options": [
        {
          "value": "display",
          "label": "Large"
        },
        {
          "value": "display-sm",
          "label": "Small"
        }
      ],
      "default": "display"
    },
    {
      "type": "select",
      "id": "font",
      "label": "Font",
      "options": [
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "subheading",
          "label": "Subheading"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "heading"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Panel",
      "default": "#0F80BE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Scroll"
    },
    {
      "type": "range",
      "id": "scroll_distance",
      "label": "Scroll length",
      "info": "How much scrolling the panel takes to arrive and settle. One screen is 100.",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "%",
      "default": 140
    },
    {
      "type": "range",
      "id": "overlap",
      "label": "Overlap with the section above",
      "info": "How far this starts rising before that one has finished. Match it to that section's pause.",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "%",
      "default": 60
    },
    {
      "type": "range",
      "id": "tail",
      "label": "Pause after it",
      "info": "How long the panel holds before the next section arrives.",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "%",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Interlude"
    }
  ]
}
{% endschema %}
