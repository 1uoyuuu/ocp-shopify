{% comment %}
  "How the subscription works", built as three choices rather than a block
  of prose: pick a coffee, a rhythm and an amount, and a summary line
  assembles what that adds up to.

  It explains rather than sells. The store has no selling plans configured,
  so nothing here can add to cart — the summary is a preview and the call to
  action hands off to whichever page the merchant points it at.

  Steps are blocks, so one can be renamed, reordered or added without
  touching this file. Their numbers come from a CSS counter for the same
  reason: `content_for 'blocks'` gives no loop index, and hardcoding them
  would go stale the moment a step moved.
{% endcomment %}

{% liquid
  assign heading_font = section.settings.heading_font | default: 'heading'
  assign label_font = section.settings.label_font | default: 'subheading'

  # `content_for 'block'` only takes literal strings, so the two kinds can't
  # be rendered in separate passes — they come out together and are
  # separated by CSS instead: cards position themselves absolutely and leave
  # the flow, steps stay in it.
  assign step_blocks = section.blocks | where: 'type', 'subscription-step'

  assign align = section.settings.text_alignment | default: 'center'
  assign items = 'center'
  if align == 'left'
    assign items = 'start'
  endif
%}

<subscription-steps
  class="subscription"
  style="
    --subscription-background: {{ section.settings.background_color }};
    --subscription-text: {{ section.settings.text_color }};
    --subscription-accent: {{ section.settings.accent_color }};
    --subscription-heading-font: var(--font-{{ heading_font }}--family);
    --subscription-heading-weight: var(--font-{{ heading_font }}--weight);
    --subscription-label-font: var(--font-{{ label_font }}--family);
    --subscription-label-weight: var(--font-{{ label_font }}--weight);
    --subscription-padding-start: {{ section.settings.padding-block-start }}px;
    --subscription-padding-end: {{ section.settings.padding-block-end }}px;
    --subscription-min-height: {{ section.settings.min_height }}svh;
    --subscription-align: {{ align }};
    --subscription-items: {{ items }};
  "
>
  <div class="subscription__inner">
    <header class="subscription__header">
      {% if section.settings.eyebrow != blank %}
        <p class="subscription__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="subscription__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.intro != blank %}
        <div class="subscription__intro">{{ section.settings.intro }}</div>
      {% endif %}
    </header>

    {%- comment -%}
      With no steps added the section is just a statement and a link — which
      is how it runs on the home page, the builder being for a subscription
      page of its own later. Everything that only makes sense alongside the
      steps is left out rather than rendered empty.
    {%- endcomment -%}
    {%- comment -%}
      Holds both kinds. With no steps among them it is `display: contents`,
      so it adds neither a row nor a gap to the column and the cards inside
      still resolve their position against the section.
    {%- endcomment -%}
    {% if section.blocks.size > 0 %}
      <div class="subscription__blocks{% if step_blocks.size > 0 %} subscription__steps{% endif %}">
        {% content_for 'blocks' %}
      </div>
    {% endif %}

    <div class="subscription__summary">
      {% if step_blocks.size > 0 %}
        {% if section.settings.summary_label != blank %}
          <p class="subscription__summary-label">{{ section.settings.summary_label }}</p>
        {% endif %}

        {%- comment -%}
          Filled in by subscription-steps.js. Hidden until the element is
          defined so it can't sit empty if the module never loads — the steps
          above still read correctly on their own.
        {%- endcomment -%}
        <p
          class="subscription__summary-line"
          ref="summary"
          role="status"
        ></p>
      {% endif %}

      {% if section.settings.cta_label != blank %}
        {% if section.settings.cta_link != blank %}
          <a
            class="subscription__cta"
            href="{{ section.settings.cta_link }}"
          >
            {{- section.settings.cta_label -}}
          </a>
        {% else %}
          {%- comment -%}
            No destination set yet, so this renders as plain text rather than
            a link that would reload the page. The layout still reads as
            finished in the editor.
          {%- endcomment -%}
          <span class="subscription__cta subscription__cta--inert">
            {{- section.settings.cta_label -}}
          </span>
        {% endif %}
      {% endif %}
    </div>
  </div>
</subscription-steps>

{%- comment -%}
  Drives the step picking and the cards' drift, so a section with neither
  doesn't pay for it.
{%- endcomment -%}
{% if section.blocks.size > 0 %}
  <script
    src="{{ 'subscription-steps.js' | asset_url }}"
    type="module"
  ></script>
{% endif %}

{% stylesheet %}
  .subscription {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: var(--subscription-min-height, 100svh);
    background-color: var(--subscription-background, var(--color-background));
    color: var(--subscription-text, var(--color-foreground));
    padding-block: var(--subscription-padding-start, 96px) var(--subscription-padding-end, 96px);
    padding-inline: var(--ocp-page-margin);

    /* Cards are placed by their centre, so one near an edge hangs past it.
       Clipping here keeps that from widening the page. */
    overflow: clip;
  }

  .subscription__inner {
    display: flex;
    flex-direction: column;
    align-items: var(--subscription-items, center);
    gap: clamp(2.5rem, 6vw, 5rem);
    width: 100%;
    text-align: var(--subscription-align, center);
  }

  /* Lifted over the cards. Done on the copy itself rather than on
     .subscription__inner, which has to stay unpositioned so the cards
     resolve against the section and can spread across all of it. */
  .subscription__header,
  .subscription__summary {
    position: relative;
    z-index: 1;
  }

  .subscription__header {
    max-width: 46rem;
  }

  /* ---- The scatter ---------------------------------------------------- */

  /* Adds nothing to the column when it holds only cards, which are out of
     flow anyway. The steps modifier below overrides it on two classes, so it
     wins on specificity rather than on order. */
  .subscription__blocks {
    display: contents;
  }

  .subscription-card {
    position: absolute;
    left: var(--card-x, 50%);
    top: var(--card-y, 50%);
    width: var(--card-width, 12%);

    /* The -50% pair is what makes --card-x/--card-y address the card's
       centre; the drift and the tilt compose after it. --card-shift-* are
       written by subscription-steps.js and default to nothing, so the
       resting arrangement stands on its own without the script. */
    transform: translate(-50%, -50%) translate3d(var(--card-shift-x, 0px), var(--card-shift-y, 0px), 0)
      rotate(var(--card-rotation, 0deg));
    will-change: transform;

    /* Decoration only — the call to action has to stay clickable wherever a
       card happens to land over it. */
    pointer-events: none;
  }

  .subscription-card__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .subscription-card__placeholder {
    aspect-ratio: 4 / 5;
    background-color: color-mix(in srgb, currentcolor 8%, transparent);
  }

  .subscription__eyebrow,
  .subscription__summary-label {
    margin: 0;
    font-family: var(--subscription-label-font);
    font-weight: var(--subscription-label-weight);
    font-size: 0.875rem;
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
  }

  .subscription__heading {
    margin: 0.5em 0 0;
    font-family: var(--subscription-heading-font);
    font-weight: 700;
    font-size: var(--ocp-heading-size);
    line-height: 1;
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
  }

  .subscription__intro {
    margin-block-start: 1.5rem;
    max-width: 42ch;
    font-family: var(--font-body--family);
    font-size: 1rem;
    line-height: 1.5;
  }

  /* The step numbers are drawn from this counter rather than written into
     the blocks, so reordering or adding a step renumbers the rest. */
  .subscription__blocks.subscription__steps {
    counter-reset: subscription-step;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .subscription-step__index::before {
    counter-increment: subscription-step;
    content: counter(subscription-step, decimal-leading-zero);
  }

  .subscription-step__index {
    display: block;
    font-family: var(--subscription-label-font);
    font-weight: var(--subscription-label-weight);
    font-size: 0.875rem;
    letter-spacing: var(--ocp-letter-spacing);
    color: var(--subscription-accent);
  }

  .subscription-step__title {
    margin: 0.75rem 0 0;
    padding-block-end: 0.75rem;
    border-block-end: 1px solid currentcolor;
    font-family: var(--subscription-label-font);
    font-weight: var(--subscription-label-weight);
    font-size: 0.875rem;
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
  }

  .subscription-step__options {
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.75rem;
  }

  .subscription-step__option {
    /* Reset rather than inherit the theme's button chrome — these read as
       lines of type, not as controls. */
    appearance: none;
    border: 0;
    background: none;
    padding: 0;
    margin: 0;
    text-align: start;
    cursor: pointer;

    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4em;

    font-family: var(--subscription-heading-font);
    font-weight: var(--subscription-heading-weight);
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    line-height: 1.15;
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;

    /* Unchosen options recede rather than disappear, so the full range of
       what's on offer still reads at a glance. */
    color: color-mix(in srgb, currentcolor 45%, transparent);
    transition: color 0.2s ease;
  }

  .subscription-step__option[aria-pressed='true'] {
    color: var(--subscription-accent);
  }

  .subscription-step__option:hover {
    color: color-mix(in srgb, var(--subscription-accent) 70%, currentcolor);
  }

  .subscription-step__option-note {
    font-family: var(--subscription-label-font);
    font-weight: var(--subscription-label-weight);
    font-size: 0.75rem;
  }

  .subscription__summary {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.75rem;
  }

  .subscription__summary-line {
    margin: 0;
    font-family: var(--subscription-heading-font);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.4vw, 2rem);
    line-height: 1.2;
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
    color: var(--subscription-accent);
  }

  /* Nothing has filled it in yet — and if the module never loads, nothing
     will. */
  subscription-steps:not(:defined) .subscription__summary-line {
    display: none;
  }

  .subscription__cta {
    margin-block-start: 0.5rem;
    font-family: var(--subscription-label-font);
    font-weight: var(--subscription-label-weight);
    font-size: 0.875rem;
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--subscription-text, var(--color-foreground));
    border-block-end: 1px solid currentcolor;
    padding-block-end: 0.25rem;
  }

  .subscription__cta--inert {
    opacity: 0.45;
  }

  @media screen and (max-width: 749px) {
    .subscription__blocks.subscription__steps {
      grid-template-columns: 1fr;
    }

  }

  /*
   * The cards are laid out around a clear band through the middle of the
   * section — but that band is a share of the width, while the copy has a
   * fixed maximum. Below about 1300px the copy is the wider of the two and
   * the scatter starts landing on it.
   *
   * So above that the copy is held inside the band, and below 990px, where
   * doing that would leave it too narrow to read, the cards step aside
   * instead. Rearranging them would mean a second set of positions to keep
   * in step with the first, for decoration.
   */
  @media screen and (min-width: 990px) {
    .subscription .subscription__header {
      max-width: min(46rem, 52vw);
    }
  }

  @media screen and (max-width: 989px) {
    .subscription .subscription-card {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Subscription steps",
  "tag": "section",
  "blocks": [
    {
      "type": "subscription-card"
    },
    {
      "type": "subscription-step"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label above the heading",
      "default": "(How it works)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build your subscription"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "header",
      "content": "Summary"
    },
    {
      "type": "text",
      "id": "summary_label",
      "label": "Summary label",
      "info": "Sits above the line that assembles the chosen options. Only shown when the section has steps.",
      "default": "(Your box)"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Start a subscription"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Until this is set the label shows as plain text rather than a link."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "center", "label": "Centred" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "info": "The scatter needs room to spread out.",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Selected option and numbers",
      "default": "#0f80be"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "heading", "label": "Heading" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "label_font",
      "label": "Label font",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "heading", "label": "Heading" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "subheading"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Subscription steps",
      "blocks": [
        {
          "type": "subscription-step",
          "settings": {
            "title": "Your coffee",
            "options": "Blend | Australian roaster\nRotation single origin | Australian roaster\nRotation single origin | International roaster"
          }
        },
        {
          "type": "subscription-step",
          "settings": {
            "title": "Your rhythm",
            "options": "Weekly\nFortnightly\nMonthly"
          }
        },
        {
          "type": "subscription-step",
          "settings": {
            "title": "Your amount",
            "options": "1 bag\n2 bags\n3 bags\n4 bags"
          }
        }
      ]
    }
  ]
}
{% endschema %}
