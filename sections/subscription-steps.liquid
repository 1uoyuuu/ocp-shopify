{% comment %}
  The subscription pitch, built as a grid the reader falls through.

  Three beats in one section: the heading alone on a full screen; a broken
  grid of the coffees drifting up over it while it holds and shrinks; then
  what the subscription actually asks, and the way in.

  The grid is deliberately not a product list. Every slot is a fixed-ratio
  box placed on an explicit column, so the composition does not depend on the
  photographs — a bag can be swapped for a taller one and nothing moves. The
  irregularity is authored in PATTERN below, not random, and products fill it
  in order and cycle, so a collection of four reads as a wall of fourteen and
  adding a fifth does not break the arrangement.

  The file is still named for the steps it used to hold. Renaming it would
  mean changing the section type in templates/index.json in the same commit,
  which is the one thing this theme's sync is worst at — see CLAUDE.md.
{% endcomment %}

{% liquid
  assign heading_font = section.settings.heading_font | default: 'heading'
  assign label_font = section.settings.label_font | default: 'subheading'

  assign align = section.settings.text_alignment | default: 'center'
  assign items = 'center'
  if align == 'left'
    assign items = 'start'
  endif

  assign products = collections[section.settings.collection].products
  assign product_count = products.size

  comment
    One slot per entry: row, column, size, vertical shift as a share of its
    own height, horizontal nudge as a share of its own width, resting
    opacity, then the row and column it takes on a narrow screen. A narrow
    row of 0 drops it there — below 990px the grid is re-composed out of nine
    of these rather than squeezed into six columns.

    Size decides the span on both grids, but not the same span: three of
    twelve wide, four of six narrow. A tier that is a quarter of a laptop is
    two thirds of a phone — held to its share of twelve, the small bags come
    out at sixty-odd pixels, which is a thumbnail of a coffee bag rather than
    a coffee bag.
  endcomment
  assign pattern = '1,1,l,0,-14,100,1,1|1,4,s,50,0,100,1,5|1,6,m,10,0,40,0,0|1,9,m,-50,0,100,2,2|1,12,s,-50,0,20,0,0|2,1,m,-25,-20,100,3,1|2,3,s,50,0,20,0,0|2,5,m,0,0,100,6,1|2,8,s,-50,0,20,0,0|2,10,l,0,0,100,4,3|3,1,l,0,-10,100,5,1|3,4,s,-50,0,20,0,0|3,9,m,30,0,100,6,4|3,12,s,0,0,20,3,5'
  assign slots = pattern | split: '|'
%}

<subscription-grid
  class="subscription"
  style="
    --subscription-background: {{ section.settings.background_color }};
    --subscription-text: {{ section.settings.text_color }};
    --subscription-accent: {{ section.settings.accent_color }};
    --subscription-heading-font: var(--font-{{ heading_font }}--family);
    --subscription-heading-weight: var(--font-{{ heading_font }}--weight);
    --subscription-label-font: var(--font-{{ label_font }}--family);
    --subscription-label-weight: var(--font-{{ label_font }}--weight);
    --subscription-padding-start: {{ section.settings.padding-block-start }}px;
    --subscription-padding-end: {{ section.settings.padding-block-end }}px;
    --subscription-align: {{ align }};
    --subscription-items: {{ items }};
    --subscription-pin-scale: {{ section.settings.pin_scale | divided_by: 100.0 }};
  "
>
  {%- comment -%}
    The stage is what the heading is sticky within, so it lets go at the end
    of the grid rather than riding into the paragraph below.
  {%- endcomment -%}
  <div
    class="subscription__stage"
    ref="stage"
  >
    <div class="subscription__pin">
      <header
        class="subscription__header"
        ref="pin"
      >
        {% if section.settings.eyebrow != blank %}
          <p class="subscription__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="subscription__heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </header>
    </div>

    <div class="subscription__grid">
      {% for slot in slots %}
        {% liquid
          assign f = slot | split: ','
          assign row = f[0]
          assign col = f[1]
          assign tier = f[2]
          assign shift = f[3]
          assign nudge = f[4]
          assign rest = f[5]
          assign row_sm = f[6]
          assign col_sm = f[7]

          assign image = ''
          if product_count > 0
            assign index = forloop.index0 | modulo: product_count
            assign image = products[index].featured_image
          endif
        %}
        <div
          class="subscription-slot"
          data-slot
          data-tier="{{ tier }}"
          {% if row_sm == '0' %}
            data-small="off"
          {% endif %}
          aria-hidden="true"
          style="
            --slot-row: {{ row }};
            --slot-col: {{ col }};
            --slot-row-sm: {{ row_sm }};
            --slot-col-sm: {{ col_sm }};
            --slot-shift: {{ shift }}%;
            --slot-nudge: {{ nudge }}%;
            --slot-rest: {{ rest | plus: 0 | divided_by: 100.0 }};
          "
        >
          <div class="subscription-slot__frame">
            {%- comment -%}
              Two layers, because two things move it: the scroll writes a
              transform on the first, the pointer writes one on the second.
              One element would mean the two fighting over one property.
            {%- endcomment -%}
            <div
              class="subscription-slot__travel"
              data-travel
            >
              <div
                class="subscription-slot__media"
                data-media
              >
                {% if image != blank %}
                  {{
                    image
                    | image_url: width: 900
                    | image_tag:
                      class: 'subscription-slot__image',
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 25vw, 50vw',
                      widths: '200,300,450,600,900'
                  }}
                {% else %}
                  <div class="subscription-slot__placeholder"></div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="subscription__screen subscription__screen--detail">
    <div class="subscription__inner">
      {% if section.settings.intro != blank %}
        <div class="subscription__intro">{{ section.settings.intro }}</div>
      {% endif %}

      {% if section.settings.cta_label != blank %}
        {% if section.settings.cta_link != blank %}
          <a
            class="subscription__cta"
            href="{{ section.settings.cta_link }}"
          >
            {{- section.settings.cta_label -}}
          </a>
        {% else %}
          {%- comment -%}
            No destination set yet, so this renders as plain text rather than
            a link that would reload the page. The layout still reads as
            finished in the editor.
          {%- endcomment -%}
          <span class="subscription__cta subscription__cta--inert">
            {{- section.settings.cta_label -}}
          </span>
        {% endif %}
      {% endif %}
    </div>
  </div>
</subscription-grid>

<script
  src="{{ 'subscription-grid.js' | asset_url }}"
  type="module"
></script>

{% stylesheet %}
  .subscription {
    display: block;
    background-color: var(--subscription-background, var(--color-background));
    color: var(--subscription-text, var(--color-foreground));
    padding-inline: var(--ocp-page-margin);
  }

  /* ---- The heading, held ----------------------------------------------- */

  /*
   * The stage is the sticky heading's containing block, so it is released at
   * the end of the grid instead of riding down into the paragraph.
   */
  .subscription__stage {
    position: relative;
    padding-block-start: var(--subscription-padding-start, 96px);
  }

  /*
   * Its own height is taken back out of the flow, so the grid below decides
   * where the first row lands rather than starting a screen down. It is the
   * grid that moves; this only ever sits in the middle of the viewport.
   */
  .subscription__pin {
    position: sticky;
    top: 0;
    z-index: 0;

    display: flex;
    align-items: center;
    justify-content: center;
    height: 100lvh;
    margin-block-end: -100lvh;

    /* Decoration behaves, but the heading must not eat clicks meant for the
       page underneath it once it has faded out. */
    pointer-events: none;
  }

  .subscription__header {
    text-align: var(--subscription-align, center);

    /* Written by subscription-grid.js. Stated here so the composition is
       right before it runs, and stays right if it never does. */
    opacity: var(--pin-opacity, 1);
    scale: var(--pin-scale, 1);
    will-change: scale, opacity;
  }

  /* ---- The grid --------------------------------------------------------- */

  /*
   * Six columns, twelve on a wide screen — and every slot is placed on an
   * explicit column line rather than flowed. That is what makes an irregular
   * arrangement survive a change of content: nothing is packed against
   * anything else, so nothing reflows when a bag is swapped.
   */
  .subscription__grid {
    position: relative;
    z-index: 1;

    display: grid;
    grid-template-columns: repeat(6, 1fr);
    column-gap: var(--ocp-page-margin);
    row-gap: clamp(5rem, 16vh, 16rem);

    /* Clears the held heading before the first row reaches it, and leaves
       the last row somewhere to travel before the paragraph. */
    margin-block-start: 55lvh;
    padding-block: 25lvh 30lvh;
  }

  @media screen and (min-width: 990px) {
    .subscription .subscription__grid {
      grid-template-columns: repeat(12, 1fr);
    }
  }

  /*
   * The size tier is one decision with three consequences: how many columns
   * the slot spans, how far it travels on scroll, and how far it drifts under
   * the pointer. The last two are in subscription-grid.js; only the span is a
   * matter of layout.
   */
  .subscription-slot {
    --slot-span: 2;

    grid-row: var(--slot-row-sm);
    grid-column: var(--slot-col-sm) / span var(--slot-span);

    /* The authored break in the rhythm — a share of the slot's own box, so it
       holds at every width without a second set of numbers. */
    transform: translate(var(--slot-nudge, 0%), var(--slot-shift, 0%));
    opacity: var(--slot-rest, 1);
  }

  /*
   * One rule per tier at each width rather than a base plus overrides: three
   * selectors that cannot both match are three selectors that cannot tie, and
   * a tie here would be settled by source order in a bundle this theme
   * concatenates in an order we do not control.
   */
  .subscription-slot[data-tier='l'] {
    --slot-span: 3;
  }

  .subscription-slot[data-tier='m'] {
    --slot-span: 2;
  }

  .subscription-slot[data-tier='s'] {
    --slot-span: 1;
  }

  @media screen and (max-width: 989px) {
    .subscription .subscription-slot[data-tier='l'] {
      --slot-span: 4;
    }

    .subscription .subscription-slot[data-tier='m'] {
      --slot-span: 3;
    }

    .subscription .subscription-slot[data-tier='s'] {
      --slot-span: 2;
    }
  }

  @media screen and (min-width: 990px) {
    .subscription .subscription-slot {
      grid-row: var(--slot-row);
      grid-column: var(--slot-col) / span var(--slot-span);
    }
  }

  /* Nine of the fourteen make the narrow composition. Dropping the rest is
     the point — squeezing all of them into six columns is a product list, not
     an arrangement. */
  @media screen and (max-width: 989px) {
    .subscription .subscription-slot[data-small='off'] {
      display: none;
    }

    /*
     * And the heading changes sides. On a wide screen the coffees passing in
     * front of it is the whole gesture and the type is big enough to survive
     * it; at 390px the heading is two short lines and a single bag is most of
     * the width, so the same gesture just buries it. Above, here — the bags
     * pass behind instead, which still reads as depth and always reads as
     * words.
     */
    .subscription .subscription__pin {
      z-index: 2;
    }
  }

  /*
   * A box of fixed proportion, so the grid's geometry owes nothing to the
   * photographs. The bags are cut-outs, so they are contained rather than
   * cropped — a slot is somewhere for one to sit, not a frame around it.
   */
  .subscription-slot__frame {
    position: relative;
    padding-block-start: 130%;
  }

  .subscription-slot__travel,
  .subscription-slot__media {
    position: absolute;
    inset: 0;
  }

  .subscription-slot__travel {
    will-change: transform;
  }

  .subscription-slot__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .subscription-slot__placeholder {
    width: 100%;
    height: 100%;
    background-color: color-mix(in srgb, currentcolor 8%, transparent);
  }

  /* ---- What it asks ----------------------------------------------------- */

  .subscription__screen--detail {
    position: relative;
    z-index: 1;

    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100lvh;
    padding-block-end: var(--subscription-padding-end, 96px);
  }

  .subscription__inner {
    display: flex;
    flex-direction: column;
    align-items: var(--subscription-items, center);
    gap: clamp(2.5rem, 6vw, 5rem);
    width: 100%;
    text-align: var(--subscription-align, center);
  }

  .subscription__eyebrow {
    margin: 0;
    font-family: var(--subscription-label-font);
    font-weight: var(--subscription-label-weight);
    font-size: var(--ocp-text-size);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
  }

  .subscription__heading {
    margin: 0.5em 0 0;
    font-family: var(--subscription-heading-font);
    font-weight: 700;
    font-size: var(--ocp-display-size);
    line-height: var(--ocp-leading-display);
    letter-spacing: var(--ocp-letter-spacing);
  }

  .subscription__intro {
    max-width: 30ch;
    font-family: var(--subscription-heading-font);
    font-weight: var(--subscription-heading-weight);
    font-size: var(--ocp-display-size-sm);
    line-height: var(--ocp-leading-display);
    letter-spacing: var(--ocp-letter-spacing);
  }

  .subscription__intro > :first-child {
    margin-block-start: 0;
  }

  .subscription__intro > :last-child {
    margin-block-end: 0;
  }

  .subscription__cta {
    font-family: var(--subscription-label-font);
    font-weight: var(--subscription-label-weight);
    font-size: var(--ocp-text-size);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--subscription-text, var(--color-foreground));

    /* Drawn rather than declared: text-decoration does not cross into an
       inline-block, and the swap makes every word one, so a declared underline
       would vanish the moment the words are boxed — and only on hover, which
       is the worst way to find out. A line of its own also stays put while
       they roll over it. */
    padding-block-end: 0.18em;
    background: linear-gradient(currentcolor, currentcolor) 0 100% / 100% 1px no-repeat;
  }

  .subscription__cta--inert {
    opacity: 0.45;
  }

  /* Everything the script does is motion. Left alone, the composition above
     is already the finished one. */
  @media (prefers-reduced-motion: reduce) {
    .subscription-slot__travel,
    .subscription-slot__media {
      transform: none;
    }

    .subscription__header {
      scale: 1;
      opacity: 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Subscription grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label above the heading",
      "default": "(Subscriptions)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Coffee on repeat."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Subscribe now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Until this is set the label shows as plain text rather than a link."
    },
    {
      "type": "header",
      "content": "The grid"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coffees",
      "info": "Their images fill the arrangement in order and repeat, so a short collection still fills it."
    },
    {
      "type": "range",
      "id": "pin_scale",
      "label": "Heading size once the grid arrives",
      "info": "How far the held heading shrinks as the coffees rise over it.",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "center", "label": "Centred" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#0f80be"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#0f80be"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "heading", "label": "Heading" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "label_font",
      "label": "Label font",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "heading", "label": "Heading" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "subheading"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Subscription grid"
    }
  ]
}
{% endschema %}
