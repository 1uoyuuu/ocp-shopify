{% comment %}
  The questions at the foot of the subscription page: the heading on the
  left, and on the right the line of introduction with the questions listed
  under it. Each question is a block, so a new one is one click in the
  editor. Goes through the coffee page's own disclosure, so it has the same
  rule, arrow and open-one-close-the-rest behaviour rather than a second
  accordion to keep in step with it.

  A screen tall like the panels above it, with everything held to the top:
  the questions open and close, and centred content would jump every time
  one did.

  Not a `{% doc %}`: those are not valid in sections.
{% endcomment %}

<section class="subscription-faq" {{ section.shopify_attributes }}>
  {%- if section.settings.heading != blank -%}
    <h2 class="subscription-faq__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="subscription-faq__content">
    {%- if section.settings.intro != blank -%}
      <div class="subscription-faq__intro rte">{{ section.settings.intro }}</div>
    {%- endif -%}

    <div class="subscription-faq__items">
      {%- for block in section.blocks -%}
        {%- capture answer_html -%}
          <div class="rte">{{ block.settings.answer }}</div>
        {%- endcapture -%}
        {%- assign question = block.settings.question -%}
        <div {{ block.shopify_attributes }}>
          {% render 'coffee-disclosure', heading: question, body: answer_html %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .subscription-faq {
    display: grid;
    grid-template-columns: 1fr;
    align-content: start;
    gap: 2rem var(--ocp-page-margin);
    padding: var(--ocp-page-margin);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .subscription-faq__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--ocp-display-size-sm);
    line-height: var(--ocp-leading-display);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
  }

  .subscription-faq__content {
    display: grid;
    gap: 3rem;
    align-content: start;
  }

  .subscription-faq__intro {
    font-family: var(--font-body--family);
    font-size: var(--ocp-text-size);
    line-height: var(--ocp-leading-text);
    letter-spacing: var(--ocp-letter-spacing);
  }

  .subscription-faq__intro > :first-child {
    margin-block-start: 0;
  }

  .subscription-faq__intro > :last-child {
    margin-block-end: 0;
  }

  .subscription-faq .coffee-disclosure__body {
    font-family: var(--font-body--family);
    font-size: var(--ocp-text-size);
    line-height: var(--ocp-leading-text);
    letter-spacing: var(--ocp-letter-spacing);
  }

  .subscription-faq .coffee-disclosure__body .rte > :first-child {
    margin-block-start: 0;
  }

  .subscription-faq .coffee-disclosure__body .rte > :last-child {
    margin-block-end: 0;
  }

  @media screen and (min-width: 750px) {
    .subscription-faq {
      grid-template-columns: 1fr 1fr;
      min-height: 100lvh;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Subscription FAQ",
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Can I choose the coffee I receive?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>You choose how you brew and which roasters you want to hear from. Which coffee arrives is our call.</p>"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Still have questions?"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Anything not covered here, get in touch and we will help.</p>"
    }
  ],
  "presets": [
    {
      "name": "Subscription FAQ",
      "blocks": [{ "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
