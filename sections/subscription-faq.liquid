{% comment %}
  The questions under the subscription page, on the same split screen as
  the panels above them. Each question is a block, so a new one is one click
  in the editor. Goes through the coffee page's own
  disclosure, so it has the same rule, arrow and open-one-close-the-rest
  behaviour rather than a second accordion to keep in step with it.

  Not a `{% doc %}`: those are not valid in sections.
{% endcomment %}

{%- liquid
  assign side = section.settings.image_side | default: 'left'
-%}

<section class="subscription-faq subscription-faq--image-{{ side }}" {{ section.shopify_attributes }}>
  <div class="subscription-faq__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag: sizes: '(min-width: 750px) 50vw, 100vw', class: 'subscription-faq__image', loading: 'lazy' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'subscription-faq__image' }}
    {%- endif -%}
  </div>

  <div class="subscription-faq__text">
    <div class="subscription-faq__inner">
      <div class="subscription-faq__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="subscription-faq__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="subscription-faq__intro-text rte">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>

      <div class="subscription-faq__items">
        {%- for block in section.blocks -%}
          {%- capture answer_html -%}
            <div class="rte">{{ block.settings.answer }}</div>
          {%- endcapture -%}
          {%- assign question = block.settings.question -%}
          <div {{ block.shopify_attributes }}>
            {% render 'coffee-disclosure', heading: question, body: answer_html %}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .subscription-faq {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .subscription-faq__media {
    position: relative;
    min-height: 60lvh;
    overflow: hidden;
  }

  .subscription-faq__media .subscription-faq__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Equal padding on all four sides, like the panels above. Unlike them the
     content is held to the top rather than centred: the questions open and
     close, and centred content would re-centre — jump — every time one did. */
  .subscription-faq__text {
    display: grid;
    align-content: start;
    justify-items: center;
    padding: var(--ocp-page-margin);
  }

  .subscription-faq__inner {
    display: grid;
    gap: 2rem;
    width: 100%;
    max-width: 32rem;
  }

  .subscription-faq__heading {
    margin: 0 0 1rem;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--ocp-display-size-sm);
    line-height: var(--ocp-leading-display);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
  }

  .subscription-faq__intro-text {
    font-family: var(--font-body--family);
    font-size: var(--ocp-text-size);
    line-height: var(--ocp-leading-text);
    letter-spacing: var(--ocp-letter-spacing);
  }

  .subscription-faq__intro-text > :first-child {
    margin-block-start: 0;
  }

  .subscription-faq__intro-text > :last-child {
    margin-block-end: 0;
  }

  .subscription-faq .coffee-disclosure__body {
    font-family: var(--font-body--family);
    font-size: var(--ocp-text-size);
    line-height: var(--ocp-leading-text);
    letter-spacing: var(--ocp-letter-spacing);
  }

  .subscription-faq .coffee-disclosure__body .rte > :first-child {
    margin-block-start: 0;
  }

  .subscription-faq .coffee-disclosure__body .rte > :last-child {
    margin-block-end: 0;
  }

  @media screen and (min-width: 750px) {
    .subscription-faq {
      grid-template-columns: 1fr 1fr;
      min-height: 100lvh;
    }

    .subscription-faq__media {
      min-height: 0;
    }

    .subscription-faq--image-right .subscription-faq__media {
      order: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Subscription FAQ",
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Can I choose the coffee I receive?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>You choose how you brew and which roasters you want to hear from. Which coffee arrives is our call.</p>"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Still have questions?"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Anything not covered here, get in touch and we will help.</p>"
    }
  ],
  "presets": [
    {
      "name": "Subscription FAQ",
      "blocks": [{ "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
