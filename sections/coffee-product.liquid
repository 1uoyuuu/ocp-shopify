{% comment %}
  The coffee product page: three columns on one screen.

  Left holds the accordions — what the coffee is, what the roaster says
  about it, why OCP bought it — all closed, so the column is three lines
  until someone wants more. Middle is the bag on its own ground with the
  tasting notes beneath. Right is everything needed to order.

  Purpose-built rather than bent out of the stock product section, which
  is a two-column grid of media and details wrapped three deep. Splitting
  that into three would mean flattening those wrappers with
  `display: contents` and losing the settings they carry.

  Cart correctness is not reimplemented: the variant picker, quantity and
  buy buttons are the stock blocks, placed in the right-hand column and
  restyled. They only need `closest.product` and `section.id`.

  Three tiers, not two. Below 750px everything stacks in one column — bag,
  order, information — and the page scrolls normally; a phone screen is too
  narrow to hold even two of these side by side. From 750–989px the bag and
  the order sit in a row, wide enough for both, with information dropped to
  its own full-width row below rather than crammed into a third column.
  From 990px it's the three columns proper. Only that top tier locks a
  column to the viewport height — holding one to the screen on a narrower
  device would trap the reader inside a box the height of their screen.
{% endcomment %}

{% liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
%}

<div
  class="coffee-product spacing-style{% if section.settings.one_screen %} coffee-product--one-screen{% endif %}"
  style="
    --coffee-media-background: {{ section.settings.media_background }};
    --coffee-column-gap: {{ section.settings.column_gap }}px;
    --coffee-grid-gap: {{ section.settings.grid_gap }}px;
    --coffee-media-width: {{ section.settings.media_width }}fr;
    {% render 'spacing-style', settings: section.settings %}
  "
  {{ section.shopify_attributes }}
>
  <div class="coffee-product__grid">
    <div class="coffee-product__col coffee-product__col--info">
      {% content_for 'block', type: '_coffee-column', id: 'info', closest.product: product %}
    </div>

    <div class="coffee-product__col coffee-product__col--media">
      {% content_for 'block', type: '_coffee-column', id: 'media', closest.product: product %}
    </div>

    <div class="coffee-product__col coffee-product__col--buy">
      {% content_for 'block', type: '_coffee-column', id: 'buy', closest.product: product %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Coffee product",
  "tag": "section",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "checkbox",
      "id": "one_screen",
      "label": "Hold the three columns to one screen",
      "info": "Each column scrolls inside itself if it runs long. 990px and up only; below that the columns stack or share a row and the page scrolls normally.",
      "default": true
    },
    {
      "type": "color",
      "id": "media_background",
      "label": "Behind the product image",
      "info": "Shows through cut-out images that have no background of their own.",
      "default": "#f6f6f6"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Middle column width",
      "info": "Relative to the two side columns, which are 1 each.",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "unit": "x",
      "default": 1.4
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Between columns",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Between blocks in a column",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 96
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .coffee-product {
    padding-inline: var(--ocp-page-margin);
    box-sizing: border-box;
  }

  .coffee-product__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--coffee-grid-gap, 48px);
  }

  .coffee-product__col {
    min-width: 0;
    min-height: 0;
  }

  .coffee-product__col--media {
    display: flex;
    flex-direction: column;
  }

  /*
   * Stacked order below 750px: the bag first, then what orders it, then
   * what explains it — a shopper scrolling a single column meets the
   * product before the accordions, same logic as leading with the image on
   * any other card. `order` rather than reordering the markup, so the grid
   * above still auto-places info/media/buy left-to-right by source order
   * without this having to be undone there.
   */
  @media screen and (max-width: 749px) {
    .coffee-product__col--media {
      order: 1;
    }

    .coffee-product__col--buy {
      order: 2;
    }

    .coffee-product__col--info {
      order: 3;
    }
  }

  /*
   * A middle tier, 750–989px: wide enough for the bag and the order to
   * sit side by side, not wide enough for all three without crowding them.
   * Info drops to its own full-width row below rather than squeezing into
   * a third column — the three-column widths below are tuned for desktop,
   * and a tablet-width info column would run narrower than its text wants.
   *
   * `grid-template-areas` rather than `order`: the mobile tier above
   * already reorders with `order`, and a second reordering on top of that
   * is harder to read than just naming where each column actually goes.
   */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .coffee-product__grid {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'media buy'
        'info info';
    }

    .coffee-product__col--media {
      grid-area: media;
    }

    .coffee-product__col--buy {
      grid-area: buy;
    }

    .coffee-product__col--info {
      grid-area: info;
    }
  }

  /*
   * Three columns from 990px up, the middle one wider because the bag is
   * the only thing on the page with a shape of its own.
   *
   * `lvh`, not `svh` or `vh` — the largest the viewport gets, so the frame
   * still covers when a mobile address bar retracts. Every full-screen
   * frame in this theme is on `lvh`.
   *
   * The section is the frame and its own padding counts inside it
   * (`border-box`); a grid of 100lvh sitting below the padding overhangs
   * the fold by exactly that padding. The padding has to stay — the header
   * is fixed and transparent, so it takes no layout height but is still
   * painted over the top of the page.
   *
   * `min-height: 0` on the grid as well as the columns: the section is a
   * grid too, and a grid item's automatic minimum size is its content, so
   * without it the row grows to the tallest column and the frame settles
   * taller than the screen.
   */
  @media screen and (min-width: 990px) {
    .coffee-product__grid {
      grid-template-columns: 1fr var(--coffee-media-width, 1.4fr) 1fr;
    }

    /*
     * A fixed frame, not a cap. This one had been a `max-height` — short
     * content left the block shorter than the frame — but a short *info*
     * column shrank the whole row, and since the buy column stretches to
     * match, its bottom-pinned button group (`margin-block-start: auto`
     * on the variant picker) moved with it: open a short disclosure and
     * the buttons rode up, open a long one and they rode down. Fixing the
     * row at one screen always is what gives that group a fixed floor to
     * sit on regardless of which of the left column's panels is open.
     */
    .coffee-product--one-screen {
      display: grid;
      height: 100lvh;
      box-sizing: border-box;
    }

    /*
     * Set directly on each column, in the same absolute unit as the
     * frame, rather than as a percentage of the row — sizing every
     * column off the row's own height would still let the row itself
     * come from whichever column is tallest at a given moment, which is
     * exactly the moving target above. Fixed and absolute instead: always
     * one screen minus this column's own padding, full stop.
     *
     * `min-height: 0` overrides a grid item's automatic minimum size,
     * which defaults to its content — without it, opening a disclosure
     * would grow the column past its own height instead of scrolling.
     */
    .coffee-product--one-screen .coffee-product__col {
      height: calc(100lvh - var(--padding-block-start, 0px) - var(--padding-block-end, 0px));
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
    }

    /* The bag has no more to show than itself; nothing to scroll to. */
    .coffee-product--one-screen .coffee-product__col--media {
      overflow: hidden;
    }
  }

  /*
   * The order column. The stock variant picker, quantity and buy button
   * are used as they are for cart correctness, and restyled here into the
   * label-left / value-right rows the rest of the column uses.
   *
   * Scoped through `.coffee-product__col--buy` so these win on
   * specificity rather than on sitting later in the generated bundle than
   * the stock rules — within one file a rule near the top loses to a
   * stock rule further down at equal specificity.
   */

  /*
   * Two groups, not six blocks in a row: what the coffee is (roast line,
   * title) at the top, what orders it (price, variant, grind, buy button)
   * pinned to the bottom. `.coffee-column` is already a column flexbox, so
   * an auto top margin on the first block of the second group is enough —
   * it eats all the leftover height in one gap rather than spreading it
   * across all six, which is what plain `space-between` on the column
   * would do. The margin sits on price rather than on the variant picker
   * right under it, which is what keeps the two of them — styled as one
   * continuous label/value list — touching rather than split by the gap.
   *
   * That only has space to eat once `.coffee-column` itself is as tall as
   * the column around it rather than shrunk to its own content — the grid
   * already stretches `.coffee-product__col--buy` to the row's height by
   * default, so 100% here is resolving against a real, definite size.
   */
  .coffee-product__col--buy .coffee-column {
    height: 100%;
  }

  /*
   * Same label-left/value-right row as Weight below it, with a label this
   * block doesn't come with — generated rather than typed, since there's
   * no markup hook here to put real text into. `margin-inline-start: auto`
   * on the price itself does the push to the right edge instead of
   * `justify-content: space-between`, which would also spread the tax
   * note and installments line apart the moment either one is on; those
   * still get their own row below via `flex-basis: 100%`, same as before.
   */
  .coffee-product__col--buy product-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin-block-start: auto;
  }

  .coffee-product__col--buy product-price::before {
    content: 'Price';
    font-family: var(--font-subheading--family);
    font-size: var(--ocp-text-size);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /*
   * The stock block gives this div `width: 100%` (it's a <p>-like text
   * block, meant to hold a whole line to itself). At full width it has
   * nowhere to sit but its own line, which is why it was wrapping under
   * the label instead of beside it — and with nothing left to share that
   * line with once it did, `margin-inline-start: auto` had no free space
   * to spend either. `width: auto` lets it shrink back to its own content
   * so both fit on one line and the auto margin has room to push it right.
   */
  .coffee-product__col--buy product-price [ref='priceContainer'] {
    width: auto;
    margin-inline-start: auto;
    font-family: var(--font-subheading--family);
    font-size: var(--ocp-text-size);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
  }

  .coffee-product__col--buy product-price .installments {
    flex-basis: 100%;
  }

  .coffee-product__col--buy .variant-option,
  .coffee-product__col--buy .coffee-grind .variant-option {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .coffee-product__col--buy .variant-option > label {
    font-family: var(--font-subheading--family);
    font-size: var(--ocp-text-size);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /*
   * A single-value option (nothing to actually choose) skips the label/
   * fieldset markup above entirely and renders as a bare text node plus
   * a `.variant-option__swatch-value` span instead — Weight, on a coffee
   * only ever sold at one size, is this shape. Styled on the row itself
   * so both the label text and the value inherit it.
   */
  .coffee-product__col--buy .variant-option[data-testid="variant-option-single"] {
    font-family: var(--font-subheading--family);
    font-size: var(--ocp-text-size);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
  }

  .coffee-product__col--buy .variant-option__select-wrapper {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    border: 0;
  }

  /* Flush to the edge — the stock offset (var(--padding-md)) exists to
     clear an input's own border/padding, which this borderless control
     no longer has. */
  .coffee-product__col--buy .variant-option__select-wrapper .icon {
    right: 0;
  }

  /* No hover state on the grind dropdown — a plain control, not a button. */
  .coffee-product__col--buy .variant-option__select-wrapper:hover {
    border-color: transparent;
    color: inherit;
  }

  .coffee-product__col--buy .variant-option__select-wrapper:hover .variant-option__select {
    background-color: transparent;
  }

  /* The weight buttons read the same case as everything else in this
     column, rather than whatever case the variant's own value happens
     to be typed in. */
  .coffee-product__col--buy .variant-option__button-label {
    text-transform: uppercase;
  }

  .coffee-product__col--buy .variant-option__select {
    border: 0;
    padding-block: 0;
    /* Right-aligned text still needs room on that side for the absolutely
       positioned arrow (.icon, in .variant-option__select-wrapper, now
       flush against the same edge) — a flat `padding: 0` let "WHOLE BEAN"
       run underneath it. */
    padding-inline: 0 calc(var(--icon-size-2xs) + 0.3rem);
    background: none;
    text-align: end;
    text-transform: uppercase;
    font-family: var(--font-subheading--family);
    font-size: var(--ocp-text-size);
    letter-spacing: var(--ocp-letter-spacing);
    color: var(--color-foreground);
  }

  .coffee-product__col--buy .coffee-grind__help {
    display: none;
  }

  /* The add-to-cart is the one solid block of brand colour on the page. */
  .coffee-product__col--buy .button,
  .coffee-product__col--buy button[type="submit"] {
    width: 100%;
    border-radius: 0;
    font-family: var(--font-subheading--family);
    font-size: var(--ocp-text-size);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
  }

  /* Text only — the cart icon the stock button renders next to it. */
  .coffee-product__col--buy .add-to-cart-icon {
    display: none;
  }
{% endstylesheet %}
