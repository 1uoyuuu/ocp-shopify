{% comment %}
  The coffee product page: three columns on one screen.

  Left holds the accordions — what the coffee is, what the roaster says
  about it, why OCP bought it — all closed, so the column is three lines
  until someone wants more. Middle is the bag on its own ground with the
  tasting notes beneath. Right is everything needed to order.

  Purpose-built rather than bent out of the stock product section, which
  is a two-column grid of media and details wrapped three deep. Splitting
  that into three would mean flattening those wrappers with
  `display: contents` and losing the settings they carry.

  Cart correctness is not reimplemented: the variant picker, quantity and
  buy buttons are the stock blocks, placed in the right-hand column and
  restyled. They only need `closest.product` and `section.id`.

  Columns stack below 750px, in source order — information, bag, order —
  and the page scrolls normally. Holding a column to the viewport on a
  phone would trap the reader inside a box the height of their screen.
{% endcomment %}

{% liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
%}

<div
  class="coffee-product spacing-style{% if section.settings.one_screen %} coffee-product--one-screen{% endif %}"
  style="
    --coffee-media-background: {{ section.settings.media_background }};
    --coffee-column-gap: {{ section.settings.column_gap }}px;
    --coffee-grid-gap: {{ section.settings.grid_gap }}px;
    --coffee-media-width: {{ section.settings.media_width }}fr;
    {% render 'spacing-style', settings: section.settings %}
  "
  {{ section.shopify_attributes }}
>
  <div class="coffee-product__grid">
    <div class="coffee-product__col coffee-product__col--info">
      {% content_for 'block', type: '_coffee-column', id: 'info', closest.product: product %}
    </div>

    <div class="coffee-product__col coffee-product__col--media">
      {% content_for 'block', type: '_coffee-column', id: 'media', closest.product: product %}
    </div>

    <div class="coffee-product__col coffee-product__col--buy">
      {% content_for 'block', type: '_coffee-column', id: 'buy', closest.product: product %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Coffee product",
  "tag": "section",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "checkbox",
      "id": "one_screen",
      "label": "Hold the three columns to one screen",
      "info": "Each column scrolls inside itself if it runs long. Desktop only; below 750px the columns stack and the page scrolls.",
      "default": true
    },
    {
      "type": "color",
      "id": "media_background",
      "label": "Behind the product image",
      "info": "Shows through cut-out images that have no background of their own.",
      "default": "#f6f6f6"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Middle column width",
      "info": "Relative to the two side columns, which are 1 each.",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "unit": "x",
      "default": 1.4
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Between columns",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Between blocks in a column",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 96
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .coffee-product {
    padding-inline: var(--ocp-page-margin);
    box-sizing: border-box;
  }

  .coffee-product__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--coffee-grid-gap, 48px);
  }

  .coffee-product__col {
    min-width: 0;
    min-height: 0;
  }

  .coffee-product__col--media {
    display: flex;
    flex-direction: column;
  }

  /*
   * Three columns from 750px up, the middle one wider because the bag is
   * the only thing on the page with a shape of its own.
   *
   * `lvh`, not `svh` or `vh` — the largest the viewport gets, so the frame
   * still covers when a mobile address bar retracts. Every full-screen
   * frame in this theme is on `lvh`.
   *
   * The section is the frame and its own padding counts inside it
   * (`border-box`); a grid of 100lvh sitting below the padding overhangs
   * the fold by exactly that padding. The padding has to stay — the header
   * is fixed and transparent, so it takes no layout height but is still
   * painted over the top of the page.
   *
   * `min-height: 0` on the grid as well as the columns: the section is a
   * grid too, and a grid item's automatic minimum size is its content, so
   * without it the row grows to the tallest column and the frame settles
   * taller than the screen.
   */
  @media screen and (min-width: 750px) {
    .coffee-product__grid {
      grid-template-columns: 1fr var(--coffee-media-width, 1.4fr) 1fr;
    }

    /*
     * One screen is a ceiling, not a size to grow into. Short content
     * leaves the block shorter than the frame, with the padding above and
     * below reading as margin instead of the block being stretched to
     * meet the fold.
     */
    .coffee-product--one-screen {
      display: grid;
      max-height: 100lvh;
      box-sizing: border-box;
    }

    /*
     * The cap lives on each column directly, in the same absolute unit as
     * the frame, rather than as a percentage of the row. A row that only
     * ever grows to fit its content has no definite height of its own for
     * a percentage to resolve against — it would be treated as auto and
     * cap nothing. Subtracting the padding keeps column-plus-padding at
     * or under one screen either way; content past that scrolls inside
     * the column instead of growing the page.
     *
     * `min-height: 0` overrides a grid item's automatic minimum size,
     * which defaults to its content — without it, opening a disclosure
     * would grow the column past its own max-height instead of scrolling.
     */
    .coffee-product--one-screen .coffee-product__col {
      max-height: calc(100lvh - var(--padding-block-start, 0px) - var(--padding-block-end, 0px));
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
    }

    /* The bag has no more to show than itself; nothing to scroll to. */
    .coffee-product--one-screen .coffee-product__col--media {
      overflow: hidden;
    }
  }

  /*
   * The order column. The stock variant picker, quantity and buy button
   * are used as they are for cart correctness, and restyled here into the
   * label-left / value-right rows the rest of the column uses.
   *
   * Scoped through `.coffee-product__col--buy` so these win on
   * specificity rather than on sitting later in the generated bundle than
   * the stock rules — within one file a rule near the top loses to a
   * stock rule further down at equal specificity.
   */

  /*
   * Two groups, not six blocks in a row: what the coffee is (roast line,
   * title, price) at the top, what orders it (variant, grind, buy button)
   * pinned to the bottom. `.coffee-column` is already a column flexbox, so
   * an auto top margin on the first block of the second group is enough —
   * it eats all the leftover height in one gap rather than spreading it
   * across all six, which is what plain `space-between` on the column
   * would do.
   *
   * That only has space to eat once `.coffee-column` itself is as tall as
   * the column around it rather than shrunk to its own content — the grid
   * already stretches `.coffee-product__col--buy` to the row's height by
   * default, so 100% here is resolving against a real, definite size.
   */
  .coffee-product__col--buy .coffee-column {
    height: 100%;
  }

  .coffee-product__col--buy .variant-picker {
    margin-block-start: auto;
  }

  /* Price on one side, whether tax is included on the other. Installments
     get their own row below rather than a third slot in the space-between. */
  .coffee-product__col--buy product-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .coffee-product__col--buy product-price .installments {
    flex-basis: 100%;
  }

  .coffee-product__col--buy .variant-option,
  .coffee-product__col--buy .coffee-grind .variant-option {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .coffee-product__col--buy .variant-option > label {
    font-family: var(--font-subheading--family);
    font-size: var(--ocp-text-size);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .coffee-product__col--buy .variant-option__select-wrapper {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    border: 0;
  }

  /* No hover state on the grind dropdown — a plain control, not a button. */
  .coffee-product__col--buy .variant-option__select-wrapper:hover {
    border-color: transparent;
    color: inherit;
  }

  .coffee-product__col--buy .variant-option__select-wrapper:hover .variant-option__select {
    background-color: transparent;
  }

  /* The weight buttons read the same case as everything else in this
     column, rather than whatever case the variant's own value happens
     to be typed in. */
  .coffee-product__col--buy .variant-option__button-label {
    text-transform: uppercase;
  }

  .coffee-product__col--buy .variant-option__select {
    border: 0;
    padding: 0;
    background: none;
    text-align: end;
    text-transform: uppercase;
    font-family: var(--font-subheading--family);
    font-size: var(--ocp-text-size);
    letter-spacing: var(--ocp-letter-spacing);
    color: var(--color-foreground);
  }

  .coffee-product__col--buy .coffee-grind__help {
    display: none;
  }

  /* The add-to-cart is the one solid block of brand colour on the page. */
  .coffee-product__col--buy .button,
  .coffee-product__col--buy button[type="submit"] {
    width: 100%;
    border-radius: 0;
    font-family: var(--font-subheading--family);
    font-size: var(--ocp-text-size);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
  }

  /* Text only — the cart icon the stock button renders next to it. */
  .coffee-product__col--buy .add-to-cart-icon {
    display: none;
  }
{% endstylesheet %}
