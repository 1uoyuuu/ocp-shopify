{% comment %}
  What the subscription is, under the hero: a stack of rows, each a
  heading on the left and its content on the right, ruled off from the next.
  The same arrangement as the coffee page's spec table, so the two pages
  read as one shop.

  Two kinds of row. `feature` is prose, with a photograph beside it if one
  is given. `list` is short lines, each led by the OCP arrow — the benefits,
  the steps. Rows are blocks, so the owner adds, drops and reorders them in
  the editor without anything here changing.

  Not a `{% doc %}`: those are not valid in sections.
{% endcomment %}

<div class="subscription-info" {{ section.shopify_attributes }}>
  {%- for block in section.blocks -%}
    <div class="subscription-info__row" {{ block.shopify_attributes }}>
      {%- if block.settings.heading != blank -%}
        <h2 class="subscription-info__heading">{{ block.settings.heading }}</h2>
      {%- endif -%}

      <div class="subscription-info__body">
        {%- case block.type -%}
          {%- when 'feature' -%}
            <div class="subscription-info__text rte">{{ block.settings.text }}</div>
            {%- if block.settings.image != blank -%}
              <div class="subscription-info__image">
                {{ block.settings.image | image_url: width: 1200 | image_tag: sizes: '(min-width: 750px) 40vw, 100vw', loading: 'lazy' }}
              </div>
            {%- endif -%}
          {%- when 'list' -%}
            <ul class="subscription-info__list">
              {%- assign lines = block.settings.lines | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}
                {%- assign line_text = line | strip -%}
                {%- if line_text != blank -%}
                  <li>
                    <span class="subscription-info__mark" aria-hidden="true">{% render 'logo-arrow' %}</span>
                    <span>{{ line_text }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
        {%- endcase -%}
      </div>
    </div>
  {%- endfor -%}
</div>

{% stylesheet %}
  .subscription-info {
    padding-inline: var(--ocp-page-margin);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .subscription-info__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding-block: 3rem;
    border-block-end: 1px solid var(--color-foreground);
  }

  .subscription-info__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--ocp-display-size-sm);
    line-height: var(--ocp-leading-display);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
  }

  .subscription-info__body {
    display: grid;
    gap: 1.5rem;
    font-family: var(--font-body--family);
    font-size: var(--ocp-text-size);
    line-height: var(--ocp-leading-text);
    letter-spacing: var(--ocp-letter-spacing);
  }

  .subscription-info__text > :first-child {
    margin-block-start: 0;
  }

  .subscription-info__text > :last-child {
    margin-block-end: 0;
  }

  .subscription-info__image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .subscription-info__list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .subscription-info__list li {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }

  .subscription-info__mark {
    flex: 0 0 auto;
    width: 0.6em;
  }

  .subscription-info__mark svg {
    display: block;
    width: 100%;
    height: auto;
  }

  @media screen and (min-width: 750px) {
    .subscription-info__row {
      grid-template-columns: 1fr 1fr;
      gap: var(--ocp-page-margin);
    }

    .subscription-info__body:has(.subscription-info__image) {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Subscription details",
  "blocks": [
    {
      "type": "feature",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "A coffee journey"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Every delivery is picked by us from the roasters we trust, here and overseas — so you get to try what we are excited about, not what is left over.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "list",
      "name": "List",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "How it works"
        },
        {
          "type": "textarea",
          "id": "lines",
          "label": "Lines",
          "info": "One per line.",
          "default": "Choose your brew method and the roasters you want to hear from\nPick a size, how many bags and how often\nWe choose the coffee — revealed when it arrives\nPause, skip or cancel any time"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Subscription details",
      "blocks": [{ "type": "list" }, { "type": "feature" }]
    }
  ]
}
{% endschema %}
