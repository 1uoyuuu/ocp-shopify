{% comment %}
  The subscription page's first screen and the way in.

  A photograph across the whole screen, the name of the thing in the middle
  and one line under it. The way in is a bar along the bottom of the screen,
  the full width, that stays there however far the page is scrolled; it
  opens a drawer from the right where the whole subscription is chosen: the
  product's own options, the grind, how many bags, how often.

  The choices are the product's, not this section's. Every option the
  subscription product has is drawn, in the order it has them, so adding
  Decaf to Roasters or 2kg to Size in the admin changes this page without
  touching the theme. What is fixed here is only what a product cannot
  carry: grind (a line item property, for the reason coffee-grind gives),
  bag count (the cart's own quantity) and frequency (a selling plan).

  The wrapper's background is the colour all the way across. The header
  reads what is behind it by sampling wide elements; the photograph is one,
  but with no photograph chosen the colour has to be, or the header would
  read the page's white and print blue on blue.

  Not a `{% doc %}`: those are not valid in sections.
{% endcomment %}

{% liquid
  assign product = section.settings.product
  assign selected_variant = product.selected_or_first_available_variant
  assign heading_font = section.settings.heading_font | default: 'heading'
  assign plan_group = product.selling_plan_groups.first
  assign ignore_form = 'subscription-options-' | append: section.id

  assign grind_options = section.settings.grind_options | split: ','
  assign grind_key = section.settings.grind_key | default: 'Grind'
  assign max_quantity = section.settings.max_quantity | default: 4
  assign price_note = section.settings.price_note | default: 'per shipment'
  assign scrim = section.settings.darken | default: 30 | divided_by: 100.0
%}

<subscription-picker
  class="subscription-hero-wrapper"
  style="
    --sub-panel: {{ section.settings.panel_color | default: '#0f80be' }};
    --sub-panel-text: {{ section.settings.panel_text_color | default: '#ffffff' }};
    --sub-scrim: {{ scrim }};
    --sub-heading-font: var(--font-{{ heading_font }}--family);
  "
  {{ section.shopify_attributes }}
>
  <div class="subscription-hero">
    <parallax-frame class="subscription-hero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 2400 | image_tag: sizes: '100vw', class: 'subscription-hero__image', loading: 'eager', fetchpriority: 'high' }}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'subscription-hero__image' }}
      {%- endif -%}
      <div class="subscription-hero__scrim"></div>
    </parallax-frame>

    <div class="subscription-hero__content">
      <h1 class="subscription-hero__title">{{ section.settings.title }}</h1>
      {%- if section.settings.tagline != blank -%}
        <p class="subscription-hero__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- if product != blank -%}
    <button type="button" class="subscription-bar" data-sub-open>
      {{- section.settings.cta_label | default: 'Subscribe now' -}}
    </button>

    <dialog class="subscription-drawer" aria-labelledby="subscription-drawer-title-{{ section.id }}">
      <div class="subscription-drawer__inner">
        <div class="subscription-drawer__top">
          <span class="subscription-drawer__title" id="subscription-drawer-title-{{ section.id }}">
            {{- section.settings.drawer_title | default: product.title -}}
          </span>
          <button type="button" class="subscription-drawer__close" data-sub-close>Close</button>
        </div>

        <form
          class="subscription-form"
          action="{{ routes.cart_add_url }}"
          method="post"
          data-sub-form
        >
          <div class="subscription-form__groups">
            {%- for option in product.options_with_values -%}
              {%- assign option_index = forloop.index0 -%}
              <fieldset class="subscription-group">
                <legend class="subscription-group__label">{{ option.name }}</legend>
                <div class="subscription-group__choices subscription-group__choices--fill">
                  {%- for value in option.values -%}
                    <label class="subscription-choice">
                      <input
                        type="radio"
                        name="option-{{ option_index }}"
                        value="{{ value | escape }}"
                        form="{{ ignore_form }}"
                        data-option-index="{{ option_index }}"
                        {% if value == selected_variant.options[option_index] %}checked{% endif %}
                      >
                      <span class="subscription-choice__label">{{ value }}</span>
                      <span class="subscription-choice__dot" aria-hidden="true"></span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}

            {%- if grind_options.size > 0 -%}
              <fieldset class="subscription-group">
                <legend class="subscription-group__label">{{ section.settings.grind_label | default: 'Grind' }}</legend>
                <div class="subscription-group__choices">
                  {%- for grind in grind_options -%}
                    {%- assign grind_name = grind | strip -%}
                    <label class="subscription-choice">
                      <input
                        type="radio"
                        name="properties[{{ grind_key | escape }}]"
                        value="{{ grind_name | escape }}"
                        {% if forloop.first %}checked{% endif %}
                      >
                      <span class="subscription-choice__label">{{ grind_name }}</span>
                      <span class="subscription-choice__dot" aria-hidden="true"></span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endif -%}

            <fieldset class="subscription-group">
              <legend class="subscription-group__label">{{ section.settings.quantity_label | default: 'Bag amount' }}</legend>
              <div class="subscription-group__choices subscription-group__choices--fill">
                {%- for count in (1..max_quantity) -%}
                  <label class="subscription-choice">
                    <input
                      type="radio"
                      name="quantity"
                      value="{{ count }}"
                      {% if forloop.first %}checked{% endif %}
                    >
                    <span class="subscription-choice__label">{{ count }}</span>
                    <span class="subscription-choice__dot" aria-hidden="true"></span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>

            {%- if plan_group != blank -%}
              <fieldset class="subscription-group">
                <legend class="subscription-group__label">{{ section.settings.frequency_label | default: 'Frequency' }}</legend>
                <div class="subscription-group__choices subscription-group__choices--fill">
                  {%- for plan in plan_group.selling_plans -%}
                    <label class="subscription-choice">
                      <input
                        type="radio"
                        name="selling_plan"
                        value="{{ plan.id }}"
                        {% if forloop.first %}checked{% endif %}
                      >
                      {%- comment -%}
                        The selling plan app names its own options "Deliver every 2 weeks" —
                        stripped down to "Every 2 weeks" for the shorter, title-cased label
                        here. Only the display changes; the plan itself is untouched.
                      {%- endcomment -%}
                      <span class="subscription-choice__label">
                        {{- plan.options.first.value | remove_first: 'Deliver ' | capitalize -}}
                      </span>
                      <span class="subscription-choice__dot" aria-hidden="true"></span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endif -%}
          </div>

          <div class="subscription-form__footer">
            <p class="subscription-form__price">
              <span data-sub-price></span>
              <span class="subscription-form__note">{{ price_note }}</span>
            </p>

            <input type="hidden" name="id" value="{{ selected_variant.id }}" data-sub-variant-id>
            <input type="hidden" name="return_to" value="{{ routes.cart_url }}">

            <button
              type="submit"
              class="subscription-form__submit"
              data-sub-submit
              data-label-add="{{ section.settings.add_label | default: 'Add to cart' }}"
              data-label-sold-out="Sold out"
              data-label-unavailable="Unavailable"
            >
              {{- section.settings.add_label | default: 'Add to cart' -}}
            </button>
          </div>
        </form>
      </div>
    </dialog>

    <script type="application/json" data-sub-data>
      {
        "currency": {{ cart.currency.iso_code | json }},
        "locale": {{ request.locale.iso_code | json }},
        "variants": [
          {%- for variant in product.variants -%}
            {
              "id": {{ variant.id }},
              "options": {{ variant.options | json }},
              "available": {{ variant.available | json }},
              "price": {{ variant.price }},
              "plans": {
                {%- for allocation in variant.selling_plan_allocations -%}
                  "{{ allocation.selling_plan.id }}": {{ allocation.price }}{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- elsif request.design_mode -%}
    <p class="subscription-hint">
      No button yet: pick a subscription product in this section's settings. A product that is
      still a draft, or not on the Online Store channel, reads as empty to the storefront.
    </p>
  {%- endif -%}
</subscription-picker>

<script src="{{ 'subscription-picker.js' | asset_url }}" type="module" defer></script>
{% render 'parallax' %}

{% stylesheet %}
  /* Full-width colour ground: see the note at the top of the file. */
  .subscription-hero-wrapper {
    display: block;
    background: var(--sub-panel);
    color: var(--sub-panel-text);
  }

  .subscription-hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100lvh;
    padding: var(--ocp-page-margin);
    isolation: isolate;
    text-align: center;
  }

  .subscription-hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .subscription-hero__media .subscription-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Type sits straight on a photograph, so it is darkened a little; how much
     is a setting. */
  .subscription-hero__scrim {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / var(--sub-scrim, 0.3));
  }

  .subscription-hero__content {
    display: grid;
    justify-items: center;
    gap: 2rem;
    max-width: 100%;
  }

  .subscription-hero__title {
    margin: 0;
    font-family: var(--sub-heading-font);
    font-weight: 700;
    font-size: var(--ocp-display-size-sm);
    line-height: var(--ocp-leading-display);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .subscription-hero__tagline {
    max-width: 34ch;
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: var(--ocp-text-size);
    line-height: var(--ocp-leading-snug);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
    text-wrap: balance;
  }

  /* The way in: the full width of the screen, along the bottom, and it
     stays. Fixed rather than sticky — the page scrolls inside a container
     on desktop, and sticky only holds within its own parent. */
  .subscription-bar {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 5;
    width: 100%;
    min-height: 3rem;
    padding: 0 var(--ocp-page-margin);
    border: 0;
    border-block-start: 1px solid #000;
    border-radius: 0;
    background: var(--sub-panel);
    color: var(--sub-panel-text);
    cursor: pointer;
    font-family: var(--font-subheading--family);
    font-size: var(--ocp-text-size);
    line-height: var(--ocp-leading-snug);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
    transition:
      background-color 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Blue with white type turns white with blue type — the bar's own colour,
     so a change to it in the editor carries through. Focus does the same,
     for anyone on a keyboard; touch has no hover, so it is left out rather
     than sticking after a tap. */
  @media (hover: hover) and (pointer: fine) {
    .subscription-bar:hover {
      background: #fff;
      color: var(--sub-panel);
    }
  }

  .subscription-bar:focus-visible {
    background: #fff;
    color: var(--sub-panel);
    outline: none;
  }

  /* Editor only — see the markup. */
  .subscription-hint {
    position: fixed;
    inset-inline: var(--ocp-page-margin);
    inset-block-end: 4rem;
    z-index: 5;
    margin: 0;
    padding: 0.85rem 1rem;
    background: var(--color-background);
    color: var(--color-foreground);
    font-size: var(--ocp-text-size);
    line-height: var(--ocp-leading-snug);
    letter-spacing: var(--ocp-letter-spacing);
  }

  /* The drawer. A modal <dialog>, so focus, Escape and the backdrop are the
     browser's job. */
  .subscription-drawer {
    inset: 0 0 0 auto;
    width: min(32rem, 100vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--sub-panel);
    color: var(--sub-panel-text);
  }

  .subscription-drawer::backdrop {
    background: rgb(0 0 0 / 0.35);
  }

  .subscription-drawer[open] {
    animation: subscription-drawer-in 0.3s ease;
  }

  @keyframes subscription-drawer-in {
    from {
      transform: translateX(100%);
    }
  }

  .subscription-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem var(--ocp-page-margin) 0;
  }

  /* Title and close share one row, freeing the space the title used to take
     on its own line for air above the first group instead. */
  .subscription-drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 4rem;
  }

  .subscription-drawer__title,
  .subscription-drawer__close {
    font-family: var(--font-subheading--family);
    font-size: var(--ocp-text-size);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
  }

  .subscription-drawer__title {
    font-weight: 700;
  }

  .subscription-drawer__close {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .subscription-form {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
  }

  .subscription-form__groups {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1.25rem;
    overflow-y: auto;
    padding-block-end: 1.5rem;
  }

  .subscription-group {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .subscription-group__label {
    padding: 0;
    margin-block-end: 0.5rem;
    font-family: var(--font-subheading--family);
    font-weight: 700;
    font-size: var(--ocp-text-size);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
  }

  /*
   * Fixed-width columns (`auto-fill`, not `auto-fit`): a choice keeps its
   * own size regardless of how many others share its row, rather than
   * stretching to fill it — two brew types read the same width as six
   * grind options, and a row with fewer items than fit just ends early
   * instead of the last one growing to meet the edge. 9rem is deliberate:
   * at the drawer's own width, three of them plus their gaps exactly fill
   * one row, which is what puts three grind or three bag-size choices on
   * one line instead of wrapping to two.
   */
  .subscription-group__choices {
    display: grid;
    grid-template-columns: repeat(auto-fill, 9rem);
    gap: 0.5rem;
  }

  /*
   * The opposite of the above: the product's own options (brew, roasters,
   * size) and bag amount have a short, fixed list of choices rather than
   * a merchant-editable one that could grow to wrap a row — so instead of
   * a fixed column width leaving whatever is left over empty, flex grows
   * each choice equally to fill it. Two brew types split the row in half;
   * three roasters or bag-amounts split it in thirds or quarters.
   */
  .subscription-group__choices--fill {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .subscription-group__choices--fill .subscription-choice {
    flex: 1 1 0;
    min-width: 0;
  }

  .subscription-choice {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem;
    border: 1px solid currentcolor;
    cursor: pointer;
    font-family: var(--font-body--family);
    font-size: var(--ocp-text-size);
    line-height: var(--ocp-leading-snug);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
  }

  .subscription-choice input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .subscription-choice:has(input:focus-visible) {
    outline: 2px solid currentcolor;
    outline-offset: 2px;
  }

  .subscription-choice__dot {
    flex: 0 0 auto;
    width: 0.7rem;
    height: 0.7rem;
    border: 1px solid currentcolor;
    border-radius: 50%;
  }

  .subscription-choice:has(input:checked) .subscription-choice__dot {
    background: currentcolor;
  }

  .subscription-form__footer {
    display: grid;
    gap: 1rem;
    padding-block: 1.25rem;
    border-block-start: 1px solid currentcolor;
  }

  .subscription-form__price {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: var(--ocp-text-size);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
  }

  .subscription-form__note {
    opacity: 0.55;
  }

  /* Same white-with-blue-text hover as the Subscribe now bar — see the note
     there. */
  .subscription-form__submit {
    min-height: 3rem;
    border: 1px solid currentcolor;
    border-radius: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    font-family: var(--font-subheading--family);
    font-size: var(--ocp-text-size);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
    transition:
      background-color 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .subscription-form__submit:not(:disabled):hover {
      background: #fff;
      color: var(--sub-panel);
    }
  }

  .subscription-form__submit:not(:disabled):focus-visible {
    background: #fff;
    color: var(--sub-panel);
    outline: none;
  }

  .subscription-form__submit:disabled {
    cursor: not-allowed;
    opacity: 0.4;
  }

  @media (prefers-reduced-motion: reduce) {
    .subscription-drawer[open] {
      animation: none;
    }

    .subscription-bar,
    .subscription-form__submit {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Subscription hero",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Subscription product",
      "info": "Its options, selling plans and prices fill the drawer. Nothing shows until one is picked."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "OCP Subscription"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Picked by us. Freshly roasted. Delivered on repeat."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "darken",
      "label": "Darken the image",
      "info": "So the title reads over a busy photograph.",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Bar label",
      "default": "Subscribe now"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Title font",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "heading", "label": "Heading" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "heading"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Colour",
      "info": "The bar along the bottom, and what shows behind the photo.",
      "default": "#0f80be"
    },
    {
      "type": "color",
      "id": "panel_text_color",
      "label": "Colour text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Drawer"
    },
    {
      "type": "text",
      "id": "drawer_title",
      "label": "Drawer title",
      "info": "Leave empty to use the product's title."
    },
    {
      "type": "text",
      "id": "grind_label",
      "label": "Grind label",
      "default": "Grind"
    },
    {
      "type": "textarea",
      "id": "grind_options",
      "label": "Grind options",
      "info": "Comma separated. The first one is selected by default. Empty hides the grind choice.",
      "default": "Whole bean, Espresso, Aero Press, French Press, Batch Brewer, Pour Over"
    },
    {
      "type": "text",
      "id": "grind_key",
      "label": "Order property name for grind",
      "info": "Keep this the same as the coffee page's, so orders read alike.",
      "default": "Grind"
    },
    {
      "type": "text",
      "id": "quantity_label",
      "label": "Bag amount label",
      "default": "Bag amount"
    },
    {
      "type": "range",
      "id": "max_quantity",
      "label": "Most bags per delivery",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "frequency_label",
      "label": "Frequency label",
      "default": "Frequency"
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Under the price",
      "default": "per shipment"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    }
  ],
  "presets": [
    {
      "name": "Subscription hero"
    }
  ]
}
{% endschema %}
