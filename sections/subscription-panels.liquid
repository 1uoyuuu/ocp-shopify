{% comment %}
  The subscription page under the hero: an editorial stack of photo-and-text
  rows, alternating which side carries the photograph. The heading is led by
  the OCP arrow, same mark and sizing as the page hero and the locations
  page, so all three read as one family rather than three different title
  treatments.

  The photograph keeps at least its own aspect ratio — an inset photograph,
  not a full-bleed one, same technique `locations.liquid` already uses (an
  aspect-ratio set inline per block, object-fit: cover inside it) — and grows
  taller than that when the words beside it do, so it always fills its row.

  The text column is stretched to the row's full height — which the taller
  photograph decides — and the words themselves are `position: sticky`
  inside that column: they start level with the photograph's top, travel
  pinned to the viewport while the photograph scrolls past beside them, and
  land level with the photograph's bottom once the row runs out and the
  next one begins. Pure CSS: a grid row with its default `stretch`
  alignment gives the text column a box as tall as the image, and a sticky
  child can never travel further than its own containing block, so it stops
  exactly at that box's edges without any scroll math.

  One kind of block, carrying heading + prose + short lines, any of which
  can be left empty. Lines are led by the arrow too, as in the coffee page's
  spec table — a smaller mark than the heading's, so the two don't compete.

  Not a `{% doc %}`: those are not valid in sections.
{% endcomment %}

{% liquid
  assign placeholders = 'hero-apparel-1,hero-apparel-3,detailed-apparel-1,product-apparel-1' | split: ','
%}

<div class="subscription-panels" {{ section.shopify_attributes }}>
  {%- for block in section.blocks -%}
    {%- liquid
      assign side = block.settings.image_side | default: 'right'
      assign slot = forloop.index0 | modulo: placeholders.size
      assign placeholder = placeholders[slot]
      assign ratio = block.settings.aspect_ratio | default: '4 / 5'
      assign lines = block.settings.lines | newline_to_br | split: '<br />'
    -%}
    <section
      class="subscription-panel subscription-panel--image-{{ side }}"
      style="
        {% if block.settings.background_color != blank %}--panel-background: {{ block.settings.background_color }};{% endif %}
        {% if block.settings.text_color != blank %}--panel-text: {{ block.settings.text_color }};{% endif %}
      "
      {{ block.shopify_attributes }}
    >
      <div class="subscription-panel__media-col">
        <parallax-frame class="subscription-panel__media" style="aspect-ratio: {{ ratio }};">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1600 | image_tag: sizes: '(min-width: 750px) 45vw, 100vw', class: 'subscription-panel__image', loading: 'lazy' }}
          {%- else -%}
            {{ placeholder | placeholder_svg_tag: 'subscription-panel__image' }}
          {%- endif -%}
        </parallax-frame>
      </div>

      <div class="subscription-panel__text-col">
        <div class="subscription-panel__text">
          {%- if block.settings.heading != blank -%}
            <h2 class="subscription-panel__heading">
              <span class="subscription-panel__mark" aria-hidden="true">{% render 'logo-arrow' %}</span>
              <span class="subscription-panel__heading-text">{{ block.settings.heading }}</span>
            </h2>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <div class="subscription-panel__body rte">{{ block.settings.text }}</div>
          {%- endif -%}

          {%- if block.settings.lines != blank -%}
            {%- liquid
              assign list_style = block.settings.list_style | default: 'arrow'
              assign step_words = 'One,Two,Three,Four,Five,Six,Seven,Eight,Nine,Ten' | split: ','
              assign step_number = 0
            -%}
            <ul class="subscription-panel__list subscription-panel__list--{{ list_style }}">
              {%- for line in lines -%}
                {%- assign line_text = line | strip -%}
                {%- if line_text != blank -%}
                  {%- assign step_number = step_number | plus: 1 -%}
                  {%- if list_style == 'cards' -%}
                    {%- assign card_parts = line_text | split: ' | ' -%}
                    <li class="subscription-card">
                      <span class="subscription-card__label">{{ block.settings.card_label | default: 'Benefit' }}</span>
                      <span class="subscription-card__title">{{ card_parts[0] }}</span>
                      {%- if card_parts.size > 1 -%}
                        <span class="subscription-card__body">{{ card_parts[1] }}</span>
                      {%- endif -%}
                      <span class="subscription-card__number" aria-hidden="true">
                        {%- if step_number < 10 -%}0{%- endif -%}{{ step_number }}
                      </span>
                      <span class="subscription-card__mark" aria-hidden="true">{% render 'logo-arrow' %}</span>
                    </li>
                  {%- else -%}
                  <li>
                    {%- if list_style == 'steps' -%}
                      {%- assign step_index = step_number | minus: 1 -%}
                      {%- assign step_word = step_words[step_index] | default: step_number -%}
                      <span class="subscription-panel__step-label">Step {{ step_word }}:</span>
                    {%- elsif list_style == 'arrow' -%}
                      <span class="subscription-panel__list-mark" aria-hidden="true">{% render 'logo-arrow' %}</span>
                    {%- endif -%}
                    {%- if list_style == 'steps' -%}
                      {%- assign step_parts = line_text | split: ' | ' -%}
                      <span class="subscription-panel__list-text subscription-panel__step-title">{{ step_parts[0] }}</span>
                      {%- if step_parts.size > 1 -%}
                        <span class="subscription-panel__list-text subscription-panel__step-body">{{ step_parts[1] }}</span>
                      {%- endif -%}
                    {%- else -%}
                      <span class="subscription-panel__list-text">{{ line_text }}</span>
                    {%- endif -%}
                  </li>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>
    </section>
  {%- endfor -%}
</div>

{% render 'parallax' %}

{% stylesheet %}
  .subscription-panels {
    display: grid;
    gap: 6rem;
    padding: 6rem 0;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .subscription-panel {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 0 var(--ocp-page-margin);
    background: var(--panel-background, var(--color-background));
    color: var(--panel-text, var(--color-foreground));
  }

  .subscription-panel__media {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .subscription-panel__media .subscription-panel__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .subscription-panel__text {
    display: grid;
    gap: 1.5rem;
  }

  /* Same mark, same ratios as the page hero's title — a row rather than
     centred text, top-aligned because the word's line-height is taller
     than the arrow. */
  .subscription-panel__heading {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    text-align: center;
    gap: 0.11em;
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--ocp-display-size-sm);
    line-height: var(--ocp-leading-display);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
  }

  .subscription-panel__mark {
    flex: none;
    width: 0.58em;
  }

  .subscription-panel__mark svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .subscription-panel__mark svg path {
    stroke: currentColor;
    stroke-width: 5;
    stroke-linejoin: miter;
  }

  .subscription-panel__body {
    font-family: var(--font-body--family);
    font-size: var(--ocp-text-size);
    line-height: var(--ocp-leading-text);
    letter-spacing: var(--ocp-letter-spacing);
  }

  .subscription-panel__body > :first-child {
    margin-block-start: 0;
  }

  .subscription-panel__body > :last-child {
    margin-block-end: 0;
  }

  .subscription-panel__list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-body--family);
    font-size: var(--ocp-text-size);
    line-height: var(--ocp-leading-text);
    letter-spacing: var(--ocp-letter-spacing);
  }

  .subscription-panel__list li {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }

  /* Plain: the lines on their own, no marker in front. */
  .subscription-panel__list--plain li {
    display: block;
  }

  /*
   * Cards: the text column becomes a grid of tiles. Each rests in the brand
   * blue at 60% and fills to full strength under the cursor, which is also
   * when its explanation appears — title, number and arrow are all that show
   * until then. Without a hovering pointer there is nothing to reveal the
   * explanation, so a phone gets every tile at full strength with the words
   * already on it.
   */
  .subscription-panel__list--cards {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
  }

  .subscription-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
    aspect-ratio: 1;
    min-width: 0;
    padding: 0.75rem 0.75rem 4rem;
    color: var(--panel-background, var(--color-background));
    background-color: rgb(var(--color-foreground-rgb) / 0.6);
    transition: background-color 0.3s ease;
  }

  /* Three lines of the same size, told apart by weight and case: the label
     bold, the title capitalised at the regular weight, then the explanation. */
  .subscription-card__label {
    font-weight: 700;
  }

  .subscription-card__title {
    text-transform: capitalize;
  }

  /* The one gap in the card: between the title and the explanation. */
  .subscription-card__body {
    margin-block-start: 0.5rem;
    opacity: 0;
    transform: translateY(0.4rem);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .subscription-card__number {
    position: absolute;
    inset-block-end: 0.75rem;
    inset-inline-start: 0.75rem;
    font-weight: 700;
  }

  .subscription-card__mark {
    position: absolute;
    inset-block-end: 0.75rem;
    inset-inline-end: 0.75rem;
    width: 28%;
  }

  .subscription-card__mark svg {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (hover: hover) and (pointer: fine) {
    .subscription-card:hover {
      background-color: rgb(var(--color-foreground-rgb));
    }

    .subscription-card:hover .subscription-card__body {
      opacity: 1;
      transform: none;
    }
  }

  @media (hover: none), (pointer: coarse) {
    .subscription-card {
      background-color: rgb(var(--color-foreground-rgb));
    }

    .subscription-card__body {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .subscription-card,
    .subscription-card__body {
      transition: none;
    }
  }

  /*
   * A phone has one column of wide, short cards instead of the two-up grid:
   * the words on the left, the number in the top corner and the arrow under
   * it on the right. A thin line in the panel's own colour keeps them apart,
   * since the grid has no gap to do it.
   */
  @media screen and (max-width: 749px) {
    .subscription-panel__list.subscription-panel__list--cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .subscription-card {
      aspect-ratio: auto;
      min-height: 8rem;
      padding: 0.75rem 6rem 0.75rem 0.75rem;
    }

    .subscription-card + .subscription-card {
      border-block-start: 1px solid var(--panel-background, var(--color-background));
    }

    .subscription-card__number {
      inset-block-start: 0.75rem;
      inset-block-end: auto;
      inset-inline-start: auto;
      inset-inline-end: 0.75rem;
    }

    .subscription-card__mark {
      width: 4rem;
    }
  }

  /* Steps: "Step One:" over its line, one step to a block with room between
     them. The step itself is the heavier weight, the label the regular one —
     weight carries the hierarchy, not a second size. */
  .subscription-panel__list--steps {
    gap: 1.5rem;
  }

  .subscription-panel__list--steps li {
    display: block;
  }

  .subscription-panel__step-label {
    display: block;
  }

  .subscription-panel__list--steps .subscription-panel__list-text {
    display: block;
  }

  /* The first sentence of a step is the instruction and takes the weight;
     what follows it is the explanation, at the regular one. */
  .subscription-panel__list--steps .subscription-panel__step-title {
    font-weight: 700;
  }

  .subscription-panel__list-mark {
    flex: 0 0 auto;
    width: 0.6em;
  }

  .subscription-panel__list-mark svg {
    display: block;
    width: 100%;
    height: auto;
  }

  @media screen and (min-width: 750px) {
    .subscription-panel {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
      gap: var(--ocp-page-margin);
      padding-block: 2rem;
    }

    /* The photograph is at least as tall as its own aspect ratio makes it, and
       taller when the words beside it run longer: the column stretches to the
       row and the photograph grows into the room, so it is never left shorter
       than its section with empty space under it. */
    .subscription-panel__media-col {
      align-self: stretch;
      display: flex;
      flex-direction: column;
    }

    .subscription-panel__media {
      flex: 1 1 auto;
    }

    /* The text column itself stays stretched, so it has a box exactly as
       tall as the photograph for the sticky child below to roam inside. */
    /* Room on both sides of the words, so with them running the full width
       of what is left they sit in the middle of their half rather than
       against the page edge on one side and the photograph on the other. */
    .subscription-panel__text-col {
      padding-inline: clamp(1.5rem, 5vw, 5rem);
    }

    /* The cards go edge to edge in their half; the padding is for prose. */
    .subscription-panel__text-col:has(.subscription-panel__list--cards) {
      padding-inline: 0;
    }

    .subscription-panel__text {
      position: sticky;
      top: calc(var(--header-height, 0px) + 3rem);
    }

    .subscription-panel--image-left .subscription-panel__media-col {
      order: 1;
    }

    .subscription-panel--image-left .subscription-panel__text-col {
      order: 2;
    }

    .subscription-panel--image-right .subscription-panel__media-col {
      order: 2;
    }

    .subscription-panel--image-right .subscription-panel__text-col {
      order: 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Subscription panels",
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "aspect_ratio",
          "label": "Photograph shape",
          "options": [
            { "value": "1 / 1", "label": "Square" },
            { "value": "4 / 5", "label": "Portrait" },
            { "value": "3 / 2", "label": "Landscape" }
          ],
          "default": "4 / 5"
        },
        {
          "type": "select",
          "id": "image_side",
          "label": "Image side",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "right"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "A coffee journey"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "textarea",
          "id": "lines",
          "label": "Lines",
          "info": "One per line. For numbered steps or cards, put a space, a vertical bar and a space after the first phrase (it is shown bold) and the explanation after that. Leave empty for none."
        },
        {
          "type": "text",
          "id": "card_label",
          "label": "Card label",
          "info": "The small bold word at the top of each card, when the lines are shown as cards.",
          "default": "Benefit"
        },
        {
          "type": "select",
          "id": "list_style",
          "label": "Lines are shown as",
          "options": [
            { "value": "arrow", "label": "Led by the arrow" },
            { "value": "plain", "label": "Plain list" },
            { "value": "steps", "label": "Numbered steps (Step One: …)" },
            { "value": "cards", "label": "Grid of cards (shown on hover)" }
          ],
          "default": "arrow"
        },
        {
          "type": "header",
          "content": "Colours"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Text side background",
          "info": "Leave empty for the page's own."
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text colour",
          "info": "Leave empty for the page's own."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Subscription panels",
      "blocks": [{ "type": "panel" }, { "type": "panel" }]
    }
  ]
}
{% endschema %}
