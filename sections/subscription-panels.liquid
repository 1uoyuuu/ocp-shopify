{% comment %}
  The subscription page under the hero: a stack of full-screen panels, each
  split down the middle — a photograph on one half, the words on the other.
  Which side the photograph takes is chosen per panel, so the page can
  alternate as it goes down.

  The text half has the same padding on all four sides and its content is
  centred in what is left, so it sits on the true middle of the half rather
  than hanging from the top. Where a panel has no photograph yet a
  placeholder stands in, so the split always reads as a split.

  One kind of block, and it carries both prose and short lines: leave either
  empty and it simply is not drawn. Lines are led by the OCP arrow, as in the
  coffee page's spec table.

  Not a `{% doc %}`: those are not valid in sections.
{% endcomment %}

{% liquid
  assign placeholders = 'hero-apparel-1,hero-apparel-3,detailed-apparel-1,product-apparel-1' | split: ','
%}

<div class="subscription-panels" {{ section.shopify_attributes }}>
  {%- for block in section.blocks -%}
    {%- liquid
      assign side = block.settings.image_side | default: 'right'
      assign slot = forloop.index0 | modulo: placeholders.size
      assign placeholder = placeholders[slot]
      assign lines = block.settings.lines | newline_to_br | split: '<br />'
    -%}
    <section
      class="subscription-panel subscription-panel--image-{{ side }}"
      style="
        {% if block.settings.background_color != blank %}--panel-background: {{ block.settings.background_color }};{% endif %}
        {% if block.settings.text_color != blank %}--panel-text: {{ block.settings.text_color }};{% endif %}
      "
      {{ block.shopify_attributes }}
    >
      <parallax-frame class="subscription-panel__media">
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1600 | image_tag: sizes: '(min-width: 750px) 50vw, 100vw', class: 'subscription-panel__image', loading: 'lazy' }}
        {%- else -%}
          {{ placeholder | placeholder_svg_tag: 'subscription-panel__image' }}
        {%- endif -%}
      </parallax-frame>

      <div class="subscription-panel__text">
        <div class="subscription-panel__inner">
          {%- if block.settings.heading != blank -%}
            <h2 class="subscription-panel__heading">{{ block.settings.heading }}</h2>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <div class="subscription-panel__body rte">{{ block.settings.text }}</div>
          {%- endif -%}

          {%- if block.settings.lines != blank -%}
            <ul class="subscription-panel__list">
              {%- for line in lines -%}
                {%- assign line_text = line | strip -%}
                {%- if line_text != blank -%}
                  <li>
                    <span class="subscription-panel__mark" aria-hidden="true">{% render 'logo-arrow' %}</span>
                    <span>{{ line_text }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>
    </section>
  {%- endfor -%}
</div>

{% render 'parallax' %}

{% stylesheet %}
  .subscription-panel {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--panel-background, var(--color-background));
    color: var(--panel-text, var(--color-foreground));
  }

  .subscription-panel__media {
    position: relative;
    display: block;
    min-height: 60lvh;
    overflow: hidden;
  }

  .subscription-panel__media .subscription-panel__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Equal on all four sides, and the content centred in the room left. */
  .subscription-panel__text {
    display: grid;
    place-items: center;
    padding: var(--ocp-page-margin);
  }

  .subscription-panel__inner {
    display: grid;
    gap: 1.5rem;
    width: 100%;
    max-width: 32rem;
  }

  .subscription-panel__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--ocp-display-size-sm);
    line-height: var(--ocp-leading-display);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
  }

  .subscription-panel__body {
    font-family: var(--font-body--family);
    font-size: var(--ocp-text-size);
    line-height: var(--ocp-leading-text);
    letter-spacing: var(--ocp-letter-spacing);
  }

  .subscription-panel__body > :first-child {
    margin-block-start: 0;
  }

  .subscription-panel__body > :last-child {
    margin-block-end: 0;
  }

  .subscription-panel__list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-body--family);
    font-size: var(--ocp-text-size);
    line-height: var(--ocp-leading-text);
    letter-spacing: var(--ocp-letter-spacing);
  }

  .subscription-panel__list li {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }

  .subscription-panel__mark {
    flex: 0 0 auto;
    width: 0.6em;
  }

  .subscription-panel__mark svg {
    display: block;
    width: 100%;
    height: auto;
  }

  @media screen and (min-width: 750px) {
    .subscription-panel {
      grid-template-columns: 1fr 1fr;
      min-height: 100lvh;
    }

    .subscription-panel__media {
      min-height: 0;
    }

    /* The photograph goes wherever the block says; below 750px it stacks
       above the words either way. */
    .subscription-panel--image-right .subscription-panel__media {
      order: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Subscription panels",
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_side",
          "label": "Image side",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "right"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "A coffee journey"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "textarea",
          "id": "lines",
          "label": "Lines",
          "info": "One per line, each led by the arrow. Leave empty for none."
        },
        {
          "type": "header",
          "content": "Colours"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Text side background",
          "info": "Leave empty for the page's own."
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text colour",
          "info": "Leave empty for the page's own."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Subscription panels",
      "blocks": [{ "type": "panel" }, { "type": "panel" }]
    }
  ]
}
{% endschema %}
