{% comment %}
  Immersive full-bleed video hero with a genuinely locked intro timeline
  (poezabride.com-style). While the intro plays, page scrolling is fully
  blocked: scroll/swipe gestures are captured by GSAP's Observer and fed
  into the timeline's playhead instead. Only once the timeline reaches the
  end — video shrunk to its small badge (~15vw, square corners) and all
  three heading lines fully resolved — is scrolling released and the page
  continues into the next section. See hero-scroll.js.

  The heading is 3 lines in a flex column: line 1 and 2 above the video,
  line 3 below. `.hero-video__text-half--top/--bottom` are both `flex: 1`
  siblings of the fixed-size `.hero-video__video-slot` spacer between them
  — equal flex-basis on both sides keeps that spacer (and so the video,
  which scales toward dead-center independently via `position: absolute`)
  exactly vertically centered no matter how each line wraps, without
  measuring anything at runtime.

  The logo is NOT part of this section — it's `snippets/site-logo.liquid`,
  rendered once as a page-level element in layout/theme.liquid (a sibling
  of the header and main content), always `position: fixed`. hero-scroll.js
  finds it via `[data-site-logo]` and layers a GSAP override on top: big and
  centered on load, scrubbing back to its own resting (docked, small,
  top-of-viewport) CSS values as this timeline plays — so there's no
  cross-element position matching and no "becomes part of the hero" DOM
  coupling to reason about.

  The section is a plain 100svh block with no oversized scroll track, since
  the lock is enforced by Observer rather than by scroll distance. That
  keeps GSAP away from the DOM structure entirely (pinning inserts a
  wrapper element, which fights the theme's own DOM morphing on section
  re-render).

  Its own wrapper is made sticky in CSS so the sections after it rise over
  it — see the [data-stack] rules below — but that is plain CSS layering,
  not pinning, and inserts nothing.
{% endcomment %}

{% liquid
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
%}

<hero-scroll-component
  class="hero-video"
  data-skip-node-update
  data-mobile-badge-scale="{{ section.settings.mobile_badge_scale | default: 70 }}"
  {% if section.settings.stack_over %}
    data-stack
  {% endif %}
>
    <div
      class="hero-video__stage"
      ref="stage"
    >
      <div
        class="hero-video__media"
        ref="media"
      >
        {% if section.settings.video != blank %}
          {{
            section.settings.video
            | video_tag:
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              image_size: '1920x',
              class: 'hero-video__video'
          }}
        {% elsif section.settings.poster != blank %}
          {{
            section.settings.poster
            | image_url: width: 1920
            | image_tag: class: 'hero-video__video', loading: 'eager', sizes: '100vw', widths: '750,1100,1500,1920,2400'
          }}
        {% else %}
          <div class="hero-video__placeholder">
            <p>Add a video or poster image</p>
          </div>
        {% endif %}
      </div>
      <div
        class="hero-video__scrim"
        style="--hero-video-overlay-opacity: {{ overlay_opacity }};"
      ></div>
    </div>

    <div class="hero-video__composition">
      {%- comment -%}
        Three rows sharing one wrapper that shrinks to the widest of them
        (the middle one), so the top row can sit flush left and the bottom
        row flush right against the same edges.
      {%- endcomment -%}
      <div class="hero-video__lines">
        <div class="hero-video__row hero-video__row--top">
          {% if section.settings.heading_line_1 != blank %}
            <span
              class="hero-video__heading"
              ref="headingLine1"
            >
              {{ section.settings.heading_line_1 }}
            </span>
          {% endif %}
        </div>

        <div class="hero-video__row hero-video__row--mid">
          <span
            class="hero-video__heading"
            ref="headingLine2Left"
          >
            {{ section.settings.heading_line_2_left }}
          </span>

          {%- comment -%}
            Reserves the space the video lands in. hero-scroll.js sizes it to
            match the video's final footprint, so the two coincide exactly.
          {%- endcomment -%}
          <div
            class="hero-video__video-slot"
            ref="videoSlot"
          ></div>

          <span
            class="hero-video__heading"
            ref="headingLine2Right"
          >
            {{ section.settings.heading_line_2_right }}
          </span>
        </div>

        <div class="hero-video__row hero-video__row--bottom">
          {% if section.settings.heading_line_3 != blank %}
            <span
              class="hero-video__heading"
              ref="headingLine3"
            >
              {{ section.settings.heading_line_3 }}
            </span>
          {% endif %}
        </div>
      </div>
    </div>
</hero-scroll-component>

<script
  src="{{ 'gsap.min.js' | asset_url }}"
  defer
></script>
<script
  src="{{ 'gsap-observer.min.js' | asset_url }}"
  defer
></script>
<script
  src="{{ 'hero-scroll.js' | asset_url }}"
  type="module"
></script>

{% stylesheet %}
  .hero-video {
    /* The site's display size. The hero set this scale and the rest of the
       page now shares it, so it reads the token rather than restating the
       value — the middle row ("COFFEE" + video + "SHOP", none of which
       wrap) depends on the viewport-relative fallback inside it. */
    --hero-heading-size: var(--ocp-display-size);
    --hero-heading-gap: 1rem;

    display: block;
    position: relative;
    height: 100svh;
    min-height: 480px;
    background: var(--color-background, #fff);
    overflow: clip;
  }

  /* The hero holds its place and the sections after it ride up to cover it,
     rather than it scrolling away with them.

     The section *wrapper* is what sticks, not .hero-video itself: a sticky
     element is bounded by its containing block, and the hero's is its own
     wrapper — exactly its own height, so it would have nowhere to travel.
     The wrapper's containing block is <main>, which is the whole page, so
     the hero stays put until <main> ends and then unsticks on its own.
     Nothing has to be measured, and the footer (a sibling of <main>, not a
     section within it) is untouched. */
  .shopify-section:has(.hero-video[data-stack]) {
    position: sticky;
    top: 0;
    z-index: var(--layer-base);
  }

  /* Whatever follows has to be opaque and above, or the pinned hero shows
     straight through it. A section carrying its own background paints over
     this one, so this only fills in for the sections that have none. */
  .shopify-section:has(.hero-video[data-stack]) ~ .shopify-section {
    position: relative;
    z-index: var(--layer-flat);
    background-color: var(--color-background);
  }

  /* Set on <html> by hero-scroll.js while the intro timeline is playing.
     `overflow: clip` (rather than `hidden`) blocks scrolling without
     collapsing position:sticky descendants elsewhere on the page. */
  html.hero-intro-locked,
  html.hero-intro-locked body,
  html.hero-intro-locked .page-wrapper {
    overflow: clip;

    /* `overflow` alone does not hold a touch device. The browser decides a
       pan is happening at touchstart, before Observer's preventDefault on
       the first move gets a say, so a swipe could carry the page into the
       next section with the intro still unfinished. `touch-action` refuses
       the gesture outright, and `overscroll-behavior` stops a rubber-band
       at either end from handing the scroll on to the page behind. */
    touch-action: none;
    overscroll-behavior: none;
  }

  .hero-video__stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform-origin: 50% 50%;
    will-change: transform;
  }

  .hero-video__media,
  .hero-video__video,
  .hero-video__video img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* hero-scroll.js counter-scales this against the stage's uneven squash so
     the video keeps its own proportions inside a badge that doesn't share
     the viewport's. Centred, so the crop comes off both edges equally. */
  .hero-video__media {
    transform-origin: 50% 50%;
    will-change: transform;
  }

  .hero-video__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--color-foreground, #111) 8%, var(--color-background, #fff));
    color: var(--color-foreground, #111);
    font-family: var(--font-body--family);
    opacity: 0.6;
  }

  .hero-video__scrim {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: var(--hero-video-overlay-opacity, 0.2);
    pointer-events: none;
  }

  /* Centred on the viewport, so the middle row — and with it the video that
     scales toward dead-centre — lands exactly in the middle. */
  .hero-video__composition {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    pointer-events: none;
  }

  /* Shrinks to its widest row (the middle one), which gives the top and
     bottom rows a shared edge to sit flush against. This block is what's
     centred on the viewport; the video is laid out in the middle row like
     any other item and simply lands wherever that puts it, rather than the
     block being shifted to put the video on centre. */
  .hero-video__lines {
    display: flex;
    flex-direction: column;
    width: fit-content;
    max-width: 100vw;
    gap: var(--hero-heading-gap);
  }

  .hero-video__row--top {
    text-align: start;
  }

  .hero-video__row--bottom {
    text-align: end;
  }

  /* Natural widths, so each word ends where its text ends — equal-width
     side tracks would leave slack past the shorter word and push this
     row's edge (and with it the row below, which aligns to that edge)
     out beyond it. */
  .hero-video__row--mid {
    display: flex;
    align-items: center;
    gap: var(--hero-heading-gap);
  }

  /* Below this width the inline composition stops working: at 390px the two
     middle words plus their gap already need ~348px of a 390px screen, so
     nothing readable fits alongside them. The video therefore drops onto a
     row of its own and the type is free to grow.

     Keep the breakpoint in step with STACKED_LAYOUT in hero-scroll.js — the
     script sizes the badge differently on each side of it. */
  @media screen and (max-width: 749px) {
    /* Grid rather than wrapping: the two words need to stay together on the
       first row with the slot spanning beneath them, and DOM order puts the
       slot between them. Explicit placement reorders it without touching
       the markup the timeline measures. */
    .hero-video .hero-video__row--mid {
      display: grid;
      grid-template-columns: auto auto;
      justify-content: center;
      align-items: center;
      gap: var(--hero-heading-gap);
    }

    .hero-video__row--mid > .hero-video__heading:first-child {
      grid-row: 1;
      grid-column: 1;
    }

    .hero-video__row--mid > .hero-video__heading:last-child {
      grid-row: 1;
      grid-column: 2;
    }

    /* `justify-self: center` keeps the slot at the width the script gives
       it rather than stretching it across both columns. */
    .hero-video__row--mid > .hero-video__video-slot {
      grid-row: 2;
      grid-column: 1 / -1;
      justify-self: center;
    }
  }

  /* Sized by hero-scroll.js to the video's final footprint. */
  .hero-video__video-slot {
    flex: 0 0 auto;
  }

  .hero-video__heading {
    display: block;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: var(--hero-heading-size);
    line-height: 1;
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-foreground, #111);

    /* Hidden until the intro timeline applies its own "from" state. The
       GSAP scripts are deferred, so without this the headings paint at full
       opacity for a frame on load before the animation takes over. */
    opacity: 0;
  }

  /* hero-scroll.js splits each heading into per-word and per-character spans
     so the characters can be revealed in a stagger. Words stay unbreakable
     so the line still wraps between words rather than mid-word, and both
     need to be inline-block for transforms to apply to them at all. */
  .hero-video__word {
    display: inline-block;
    white-space: nowrap;
  }

  .hero-video__char {
    display: inline-block;
    will-change: transform, opacity, filter;
  }

  /* Both escape hatches for the rule above, so the headings can never be
     stranded invisible: `:not(:defined)` covers hero-scroll.js failing to
     load at all (the element never upgrades), and `[data-intro-static]` is
     set by the component itself on any path where it skips the animation
     (missing GSAP, reduced-motion). */
  hero-scroll-component:not(:defined) .hero-video__heading,
  hero-scroll-component[data-intro-static] .hero-video__heading {
    opacity: 1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero video",
  "tag": "section",
  "class": "hero-video-section",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster / fallback image",
      "info": "Used while the video loads, and as a fallback if no video is set."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "stack_over",
      "label": "Let the next section rise over this one",
      "info": "The hero stays in place while everything after it scrolls up to cover it, instead of scrolling away with the page.",
      "default": true
    },
    {
      "type": "range",
      "id": "mobile_badge_scale",
      "label": "Video size on mobile",
      "info": "How much of the screen's width the video spans once it settles, on phones only. On wider screens its height matches the heading instead. The shape stays the same either way.",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "paragraph",
      "content": "Three lines. The first sits flush left, the last flush right, and the middle line splits either side of the video. Each line is kept on one line, so keep them short."
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Line 1 — top, flush left",
      "default": "THE BEST"
    },
    {
      "type": "text",
      "id": "heading_line_2_left",
      "label": "Line 2 — before the video",
      "default": "COFFEE"
    },
    {
      "type": "text",
      "id": "heading_line_2_right",
      "label": "Line 2 — after the video",
      "default": "SHOP"
    },
    {
      "type": "text",
      "id": "heading_line_3",
      "label": "Line 3 — bottom, flush right",
      "default": "IN AUSTRALIA"
    }
  ],
  "presets": [
    {
      "name": "Hero video",
      "category": "t:categories.banners"
    }
  ]
}
{% endschema %}
