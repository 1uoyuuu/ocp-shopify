{% comment %}
  Immersive full-bleed video hero with a locked-viewport intro timeline
  (poezabride.com-style). The video and a large centered logo start
  full-viewport; scrolling through `.hero-video-track` drives a single GSAP
  timeline — never a normal page scroll — that: shrinks the video down to a
  small badge (~15vw) while the big logo travels (translate + scale) onto
  the real header logo's position, then fades/slides the heading into view.
  Once that timeline finishes, `hero-intro-done` on <body> crossfades the
  traveling logo out and the real header in at the same spot (see the
  {% style %} block), and lets scrolling continue into the next section.

  The locked-viewport feel comes from native `position: sticky` on
  `.hero-video` inside the taller `.hero-video-track`, not GSAP's `pin` —
  pinning inserts a wrapper element that fights the theme's own DOM
  morphing on section re-render. GSAP only scrubs transforms/opacity here,
  so it never touches the DOM structure. See hero-scroll.js.
{% endcomment %}

{% liquid
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
%}

{% style %}
  #header-component {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s var(--ease-out-cubic, ease);
  }

  body.hero-intro-done #header-component {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-video__logo {
    transition: opacity 0.6s var(--ease-out-cubic, ease);
  }

  body.hero-intro-done .hero-video__logo {
    opacity: 0;
    pointer-events: none;
  }
{% endstyle %}

<div class="hero-video-track">
  <hero-scroll-component
    class="hero-video"
    data-skip-node-update
  >
    <div
      class="hero-video__stage"
      ref="stage"
    >
      <div class="hero-video__media">
        {% if section.settings.video != blank %}
          {{
            section.settings.video
            | video_tag:
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              image_size: '1920x',
              class: 'hero-video__video'
          }}
        {% elsif section.settings.poster != blank %}
          {{
            section.settings.poster
            | image_url: width: 1920
            | image_tag: class: 'hero-video__video', loading: 'eager', sizes: '100vw', widths: '750,1100,1500,1920,2400'
          }}
        {% else %}
          <div class="hero-video__placeholder">
            <p>Add a video or poster image</p>
          </div>
        {% endif %}
      </div>
      <div
        class="hero-video__scrim"
        style="--hero-video-overlay-opacity: {{ overlay_opacity }};"
      ></div>
    </div>

    <div
      class="hero-video__logo"
      ref="logo"
    >
      {% render 'logo-wordmark' %}
    </div>

    {% if section.settings.heading_top != blank %}
      <div
        class="hero-video__heading hero-video__heading--top"
        ref="headingTop"
      >
        {{ section.settings.heading_top }}
      </div>
    {% endif %}

    {% if section.settings.heading_bottom != blank %}
      <div
        class="hero-video__heading hero-video__heading--bottom"
        ref="headingBottom"
      >
        {{ section.settings.heading_bottom }}
      </div>
    {% endif %}
  </hero-scroll-component>
</div>

<script
  src="{{ 'gsap.min.js' | asset_url }}"
  defer
></script>
<script
  src="{{ 'gsap-scrolltrigger.min.js' | asset_url }}"
  defer
></script>
<script
  src="{{ 'hero-scroll.js' | asset_url }}"
  type="module"
></script>

{% stylesheet %}
  .hero-video-track {
    position: relative;
    height: 280svh;
  }

  .hero-video {
    display: block;
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 480px;
    background: var(--color-background, #fff);
    overflow: clip;
  }

  .hero-video__stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform-origin: 50% 50%;
    will-change: transform, border-radius;
  }

  .hero-video__media,
  .hero-video__video,
  .hero-video__video img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-video__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--color-foreground, #111) 8%, var(--color-background, #fff));
    color: var(--color-foreground, #111);
    font-family: var(--font-body--family);
    opacity: 0.6;
  }

  .hero-video__scrim {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: var(--hero-video-overlay-opacity, 0.2);
    pointer-events: none;
  }

  .hero-video__logo {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: 70vw;
    z-index: 2;
    will-change: transform, opacity;
  }

  .hero-video__logo svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-video__heading {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    width: min(92vw, 900px);
    z-index: 3;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    font-family: var(--font-heading--family);
    font-weight: 600;
    font-size: clamp(1.75rem, 6vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--color-foreground, #111);
    will-change: transform, opacity;
  }

  /* The shrunk video settles to ~15% of the stage, dead center — these sit
     just outside that band so the sandwich reads as one composed group. */
  .hero-video__heading--top {
    bottom: 59%;
  }

  .hero-video__heading--bottom {
    top: 59%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero video",
  "tag": "section",
  "class": "hero-video-section",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster / fallback image",
      "info": "Used while the video loads, and as a fallback if no video is set."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "paragraph",
      "content": "The centered logo uses the logo set in Theme settings → Logo (inverse logo if one is set)."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "paragraph",
      "content": "The video sandwiches between these two: top text sits above the shrunk video, bottom text sits below it."
    },
    {
      "type": "textarea",
      "id": "heading_top",
      "label": "Heading — top",
      "info": "Use <br> for line breaks.",
      "default": "THE BEST<br>COFFEE SHOP"
    },
    {
      "type": "textarea",
      "id": "heading_bottom",
      "label": "Heading — bottom",
      "default": "IN AUSTRALIA"
    }
  ],
  "presets": [
    {
      "name": "Hero video",
      "category": "t:categories.banners"
    }
  ]
}
{% endschema %}
