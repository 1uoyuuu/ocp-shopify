{% comment %}
  Immersive full-bleed video hero with a genuinely locked intro timeline
  (poezabride.com-style). While the intro plays, page scrolling is fully
  blocked: scroll/swipe gestures are captured by GSAP's Observer and fed
  into the timeline's playhead instead. Only once the timeline reaches the
  end — video shrunk to its small badge (~15vw, square corners) and all
  three heading lines fully resolved — is scrolling released and the page
  continues into the next section. See hero-scroll.js.

  The heading is 3 lines in a flex column: line 1 and 2 above the video,
  line 3 below. `.hero-video__text-half--top/--bottom` are both `flex: 1`
  siblings of the fixed-size `.hero-video__video-slot` spacer between them
  — equal flex-basis on both sides keeps that spacer (and so the video,
  which scales toward dead-center independently via `position: absolute`)
  exactly vertically centered no matter how each line wraps, without
  measuring anything at runtime.

  The logo is NOT part of this section — it's `snippets/site-logo.liquid`,
  rendered once as a page-level element in layout/theme.liquid (a sibling
  of the header and main content), always `position: fixed`. hero-scroll.js
  finds it via `[data-site-logo]` and layers a GSAP override on top: big and
  centered on load, scrubbing back to its own resting (docked, small,
  top-of-viewport) CSS values as this timeline plays — so there's no
  cross-element position matching and no "becomes part of the hero" DOM
  coupling to reason about.

  The section is a plain 100svh block — no sticky/pin machinery and no
  oversized scroll track, since the lock is enforced by Observer rather
  than by scroll distance. That also keeps GSAP away from the DOM
  structure entirely (pinning inserts a wrapper element, which fights the
  theme's own DOM morphing on section re-render).
{% endcomment %}

{% liquid
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
%}

<hero-scroll-component
  class="hero-video"
  data-skip-node-update
>
    <div
      class="hero-video__stage"
      ref="stage"
    >
      <div class="hero-video__media">
        {% if section.settings.video != blank %}
          {{
            section.settings.video
            | video_tag:
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              image_size: '1920x',
              class: 'hero-video__video'
          }}
        {% elsif section.settings.poster != blank %}
          {{
            section.settings.poster
            | image_url: width: 1920
            | image_tag: class: 'hero-video__video', loading: 'eager', sizes: '100vw', widths: '750,1100,1500,1920,2400'
          }}
        {% else %}
          <div class="hero-video__placeholder">
            <p>Add a video or poster image</p>
          </div>
        {% endif %}
      </div>
      <div
        class="hero-video__scrim"
        style="--hero-video-overlay-opacity: {{ overlay_opacity }};"
      ></div>
    </div>

    <div class="hero-video__composition">
      {%- comment -%}
        Three rows sharing one wrapper that shrinks to the widest of them
        (the middle one), so the top row can sit flush left and the bottom
        row flush right against the same edges.
      {%- endcomment -%}
      <div class="hero-video__lines">
        <div class="hero-video__row hero-video__row--top">
          {% if section.settings.heading_line_1 != blank %}
            <span
              class="hero-video__heading"
              ref="headingLine1"
            >
              {{ section.settings.heading_line_1 }}
            </span>
          {% endif %}
        </div>

        <div class="hero-video__row hero-video__row--mid">
          <span
            class="hero-video__heading"
            ref="headingLine2Left"
          >
            {{ section.settings.heading_line_2_left }}
          </span>

          {%- comment -%}
            Reserves the space the video lands in. hero-scroll.js sizes it to
            match the video's final footprint, so the two coincide exactly.
          {%- endcomment -%}
          <div
            class="hero-video__video-slot"
            ref="videoSlot"
          ></div>

          <span
            class="hero-video__heading"
            ref="headingLine2Right"
          >
            {{ section.settings.heading_line_2_right }}
          </span>
        </div>

        <div class="hero-video__row hero-video__row--bottom">
          {% if section.settings.heading_line_3 != blank %}
            <span
              class="hero-video__heading"
              ref="headingLine3"
            >
              {{ section.settings.heading_line_3 }}
            </span>
          {% endif %}
        </div>
      </div>
    </div>
</hero-scroll-component>

<script
  src="{{ 'gsap.min.js' | asset_url }}"
  defer
></script>
<script
  src="{{ 'gsap-observer.min.js' | asset_url }}"
  defer
></script>
<script
  src="{{ 'hero-scroll.js' | asset_url }}"
  type="module"
></script>

{% stylesheet %}
  /* The site header stays hidden for the whole intro and fades in once it
     finishes. Keyed off the hero section being in the markup rather than off
     a JS-added class: the scripts are deferred, so a JS-driven hidden state
     would let the header paint for a frame before it applied. Pages without
     this section are unaffected, so every other template keeps its header. */
  body:has(.hero-video-section) #header-component {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s var(--ease-out-cubic, ease);
  }

  /* Reveal paths, mirroring the headings' escape hatches so the header can
     never be stranded invisible: `hero-intro-done` is set by hero-scroll.js
     when the intro completes (and immediately when it skips the animation —
     no GSAP, reduced motion), and `:not(:defined)` covers hero-scroll.js
     failing to load at all, since the element then never upgrades. */
  html.hero-intro-done body:has(.hero-video-section) #header-component,
  body:has(hero-scroll-component:not(:defined)) #header-component {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-video {
    /* Caps at 8rem, but falls back to a viewport-relative size below roughly
       1350px wide — at a fixed 8rem the middle row ("COFFEE" + video +
       "SHOP", none of which wrap) outgrows the viewport and overflows. */
    --hero-heading-size: min(8rem, 9.5vw);
    --hero-heading-gap: 1rem;

    display: block;
    position: relative;
    height: 100svh;
    min-height: 480px;
    background: var(--color-background, #fff);
    overflow: clip;
  }

  /* Set on <html> by hero-scroll.js while the intro timeline is playing.
     `overflow: clip` (rather than `hidden`) blocks scrolling without
     collapsing position:sticky descendants elsewhere on the page. */
  html.hero-intro-locked,
  html.hero-intro-locked body,
  html.hero-intro-locked .page-wrapper {
    overflow: clip;
  }

  .hero-video__stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform-origin: 50% 50%;
    will-change: transform;
  }

  .hero-video__media,
  .hero-video__video,
  .hero-video__video img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-video__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--color-foreground, #111) 8%, var(--color-background, #fff));
    color: var(--color-foreground, #111);
    font-family: var(--font-body--family);
    opacity: 0.6;
  }

  .hero-video__scrim {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: var(--hero-video-overlay-opacity, 0.2);
    pointer-events: none;
  }

  /* Centred on the viewport, so the middle row — and with it the video that
     scales toward dead-centre — lands exactly in the middle. */
  .hero-video__composition {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    pointer-events: none;
  }

  /* Shrinks to its widest row (the middle one), which gives the top and
     bottom rows a shared edge to sit flush against.

     Centring this block would leave the video off-centre, since the word
     before it is wider than the word after it. Instead the block is nudged
     by half that difference — measured in hero-scroll.js — which puts the
     video on the viewport's centre line while the block's own edges stay
     tight to the outermost words. */
  .hero-video__lines {
    display: flex;
    flex-direction: column;
    width: fit-content;
    max-width: 100vw;
    gap: var(--hero-heading-gap);
    translate: var(--hero-center-offset, 0px) 0;
  }

  .hero-video__row--top {
    text-align: start;
  }

  .hero-video__row--bottom {
    text-align: end;
  }

  /* Natural widths, so each word ends where its text ends — equal-width
     side tracks would leave slack past the shorter word and push this
     row's edge (and with it the row below, which aligns to that edge)
     out beyond it. */
  .hero-video__row--mid {
    display: flex;
    align-items: center;
    gap: var(--hero-heading-gap);
  }

  /* Sized by hero-scroll.js to the video's final footprint. */
  .hero-video__video-slot {
    flex: 0 0 auto;
  }

  .hero-video__heading {
    display: block;
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: var(--hero-heading-size);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-foreground, #111);

    /* Hidden until the intro timeline applies its own "from" state. The
       GSAP scripts are deferred, so without this the headings paint at full
       opacity for a frame on load before the animation takes over. */
    opacity: 0;
  }

  /* hero-scroll.js splits each heading into per-word and per-character spans
     so the characters can be revealed in a stagger. Words stay unbreakable
     so the line still wraps between words rather than mid-word, and both
     need to be inline-block for transforms to apply to them at all. */
  .hero-video__word {
    display: inline-block;
    white-space: nowrap;
  }

  .hero-video__char {
    display: inline-block;
    will-change: transform, opacity, filter;
  }

  /* Both escape hatches for the rule above, so the headings can never be
     stranded invisible: `:not(:defined)` covers hero-scroll.js failing to
     load at all (the element never upgrades), and `[data-intro-static]` is
     set by the component itself on any path where it skips the animation
     (missing GSAP, reduced-motion). */
  hero-scroll-component:not(:defined) .hero-video__heading,
  hero-scroll-component[data-intro-static] .hero-video__heading {
    opacity: 1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero video",
  "tag": "section",
  "class": "hero-video-section",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster / fallback image",
      "info": "Used while the video loads, and as a fallback if no video is set."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "paragraph",
      "content": "Three lines. The first sits flush left, the last flush right, and the middle line splits either side of the video. Each line is kept on one line, so keep them short."
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Line 1 — top, flush left",
      "default": "THE BEST"
    },
    {
      "type": "text",
      "id": "heading_line_2_left",
      "label": "Line 2 — before the video",
      "default": "COFFEE"
    },
    {
      "type": "text",
      "id": "heading_line_2_right",
      "label": "Line 2 — after the video",
      "default": "SHOP"
    },
    {
      "type": "text",
      "id": "heading_line_3",
      "label": "Line 3 — bottom, flush right",
      "default": "IN AUSTRALIA"
    }
  ],
  "presets": [
    {
      "name": "Hero video",
      "category": "t:categories.banners"
    }
  ]
}
{% endschema %}
