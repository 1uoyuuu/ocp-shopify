{% liquid
  assign note_field = closest.product.metafields.coffee.ocp_note
  assign has_note = note_field.value
%}
{%- capture note_html -%}{{ note_field | metafield_tag }}{%- endcapture -%}
{%- if has_note != blank -%}
  <div class="p4b">{{ note_html }}</div>
{%- endif -%}
{% schema %}
{ "name": "P4b", "tag": null }
{% endschema %}
