{% comment %}
  A footer column: a heading over a list of links.

  Links can come from a Shopify navigation menu, which is the better option
  once one exists — it keeps them managed in Navigation and they follow any
  later renaming. Failing that, the typed list is used, so a column can be
  filled in before the menus are built rather than rendering as a bare
  heading.

  A link can carry a second value beside it — opening hours, for the column
  of shops. Those cannot live in the navigation menu, so they are matched to
  it by name here, in footer-menu-row. A name that matches nothing simply
  renders as a link with no hours.
{% endcomment %}

{% liquid
  assign hour_lines = ''
  if block.settings.hours != blank
    assign hour_lines = block.settings.hours | newline_to_br | split: '<br />'
  endif
%}

<div
  class="footer-column"
  style="--footer-column-index: {{ block.settings.column }};"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h2 class="footer-column__heading">{{ block.settings.heading }}</h2>
  {% endif %}

  <ul
    class="
      footer-column__list list-unstyled
      {%- if block.settings.layout == 'horizontal' %} footer-column__list--horizontal{% endif -%}
      {%- if hour_lines != blank %} footer-column__list--paired{% endif -%}
    "
    role="list"
  >
    {% if block.settings.menu != blank %}
      {% for link in block.settings.menu.links %}
        {% render 'footer-menu-row', title: link.title, url: link.url, hour_lines: hour_lines %}
      {% endfor %}
    {% elsif block.settings.links != blank %}
      {% assign lines = block.settings.links | newline_to_br | split: '<br />' %}
      {% for line in lines %}
        {% assign trimmed = line | strip %}
        {% if trimmed == blank %}
          {% continue %}
        {% endif %}
        {% assign parts = trimmed | split: '|' %}
        {% assign row_title = parts[0] %}
        {% assign row_url = parts[1] | default: '#' %}
        {% render 'footer-menu-row', title: row_title, url: row_url, hour_lines: hour_lines %}
      {% endfor %}
    {% endif %}
  </ul>
</div>

{% schema %}
{
  "name": "Footer menu",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Preferred once the menu exists — links stay managed in Navigation. Overrides the typed list below."
    },
    {
      "type": "textarea",
      "id": "links",
      "label": "Links",
      "info": "Used only when no menu is selected. One per line, as: Label | /url"
    },
    {
      "type": "textarea",
      "id": "hours",
      "label": "Hours beside each link",
      "info": "One per line, as: Name | Hours. Matched to the links by name. Leave empty for an ordinary column of links."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "vertical", "label": "Stacked" },
        { "value": "horizontal", "label": "Side by side" }
      ],
      "default": "vertical"
    },
    {
      "type": "range",
      "id": "column",
      "label": "Column",
      "info": "Which column this sits in. Blocks sharing a column stack in their listed order.",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1
    }
  ]
}
{% endschema %}
