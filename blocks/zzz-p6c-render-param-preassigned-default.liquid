{% liquid
  assign block_settings = block.settings
  assign heading_text = block_settings.label | default: 'Why OCP bought this'
%}
<div class="p6c" {{ block.shopify_attributes }}>
  {% render 'coffee-disclosure',
    heading: heading_text,
    open: block_settings.open_by_default,
    body: 'x'
  %}
</div>
{% schema %}
{ "name": "P6c", "tag": null,
  "settings": [
    { "type": "text", "id": "label", "label": "L", "default": "hi" },
    { "type": "checkbox", "id": "open_by_default", "label": "O", "default": false }
  ]
}
{% endschema %}
