{% liquid
  assign block_settings = block.settings
  assign note_field = closest.product.metafields.coffee.ocp_note
  assign has_note = note_field.value
%}
{%- capture note_html -%}{{ note_field | metafield_tag }}{%- endcapture -%}
{%- if has_note != blank -%}
  <div class="p4d spacing-style" {{ block.shopify_attributes }}>
    {% render 'coffee-disclosure',
      heading: block_settings.label | default: 'Why OCP bought this',
      open: block_settings.open_by_default,
      body: note_html
    %}
  </div>
{%- endif -%}
{% schema %}
{ "name": "P4d", "tag": null,
  "settings": [
    { "type": "text", "id": "label", "label": "Heading", "default": "Why OCP bought this" },
    { "type": "checkbox", "id": "open_by_default", "label": "Open by default", "default": false }
  ]
}
{% endschema %}
