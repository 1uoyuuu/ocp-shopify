{% comment %}
  A footer column.
  Newsletter signup for the footer: a prompt above a single email field with
  the arrow mark doubling as the submit control.

  Uses Shopify's own `customer` form, so addresses land in the store's
  customer list tagged `newsletter` — no third-party form or app needed.
{% endcomment %}

<div
  class="footer-column footer-newsletter"
  style="--footer-column-index: {{ block.settings.column }}; --footer-column-index-md: {{ block.settings.column_md | default: 1 }}; --footer-order-sm: {{ block.settings.order_sm | default: 1 }};"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h2 class="footer-column__heading footer-newsletter__heading">{{ block.settings.heading }}</h2>
  {% endif %}

  {% form 'customer', class: 'footer-newsletter__form' %}
    <input
      type="hidden"
      name="contact[tags]"
      value="newsletter"
    >

    {% comment %} Label rather than a bare placeholder, so the field is still announced when empty. {% endcomment %}
    <label
      class="visually-hidden"
      for="FooterNewsletter-{{ block.id }}"
    >
      {{- block.settings.placeholder | default: 'Email' -}}
    </label>

    <input
      id="FooterNewsletter-{{ block.id }}"
      class="footer-newsletter__input"
      type="email"
      name="contact[email]"
      autocomplete="email"
      placeholder="{{ block.settings.placeholder | default: 'Email' | escape }}"
      required
    >

    <button
      class="footer-newsletter__submit"
      type="submit"
      aria-label="Subscribe"
    >
      <span
        class="footer-newsletter__arrow"
        aria-hidden="true"
      >
        {%- render 'logo-arrow' -%}
      </span>
    </button>

    {% if form.errors %}
      <p class="footer-newsletter__message" role="alert">
        {{ form.errors | default_errors }}
      </p>
    {% elsif form.posted_successfully? %}
      <p class="footer-newsletter__message" role="status">
        {{ block.settings.success_message | default: 'Thanks for subscribing.' }}
      </p>
    {% endif %}
  {% endform %}
</div>

{% schema %}
{
  "name": "Footer newsletter",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sign up for our newsletter"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Field placeholder",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing."
    },
    {
      "type": "range",
      "id": "column_md",
      "label": "Column at medium width",
      "info": "Which of the two columns this takes between 600 and 989px, where the footer narrows.",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "order_sm",
      "label": "Order on narrow screens",
      "info": "Where this falls in the single stacked column below 600px. Lower comes first.",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "column",
      "label": "Column",
      "info": "Which column this sits in. Blocks sharing a column stack in their listed order.",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1
    }
  ]
}
{% endschema %}
