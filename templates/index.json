{
  "sections": {
    "hero_video": {
      "type": "hero-video",
      "settings": {
        "overlay_opacity": 20
      }
    },
    "punchy_statement": {
      "type": "section",
      "blocks": {
        "jumbo_text": {
          "type": "jumbo-text",
          "settings": {
            "text": "THE ONE AND ONLY<br/>COFFEE PROJECT",
            "font": "heading",
            "alignment": "center",
            "line_height": "0.8",
            "letter_spacing": "-0.03em",
            "case": "uppercase",
            "text_effect": "reveal",
            "animation_repeat": false
          }
        }
      },
      "block_order": ["jumbo_text"],
      "settings": {
        "content_direction": "column",
        "horizontal_alignment": "center",
        "vertical_alignment": "center",
        "horizontal_alignment_flex_direction_column": "center",
        "vertical_alignment_flex_direction_column": "center",
        "gap": 16,
        "section_width": "page-width",
        "section_height": "small",
        "padding-block-start": 100,
        "padding-block-end": 100
      }
    },
    "brand_intro": {
      "type": "section",
      "blocks": {
        "intro_text": {
          "type": "text",
          "settings": {
            "text": "<p>Only Coffee Project is a small-batch roastery built around one idea: do coffee, and only coffee, properly. Beans sourced with care, roasted in small batches, shipped fresh — nothing else gets in the way.</p>",
            "width": "fit-content",
            "max_width": "narrow",
            "alignment": "center",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        }
      },
      "block_order": ["intro_text"],
      "settings": {
        "content_direction": "column",
        "horizontal_alignment": "center",
        "vertical_alignment": "center",
        "horizontal_alignment_flex_direction_column": "center",
        "vertical_alignment_flex_direction_column": "center",
        "gap": 16,
        "section_width": "page-width",
        "section_height": "small",
        "padding-block-start": 64,
        "padding-block-end": 64
      }
    },
    "featured_products": {
      "type": "product-list",
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h2>Featured Beans</h2>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h2",
            "font": "var(--font-heading--family)",
            "line_height": "tight",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        }
      },
      "block_order": ["heading"],
      "settings": {
        "collection": "",
        "layout_type": "grid",
        "max_products": 4,
        "columns": 4,
        "mobile_columns": "2",
        "columns_gap": 12,
        "rows_gap": 24,
        "section_width": "page-width",
        "padding-block-start": 64,
        "padding-block-end": 64
      }
    },
    "subscription_banner": {
      "type": "section",
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h2>Subscribe to Only Coffee Project</h2>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "h2",
            "font": "var(--font-heading--family)",
            "line_height": "tight",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "text_color": "#FFFFFF",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        },
        "body": {
          "type": "text",
          "settings": {
            "text": "<p>Fresh beans, delivered on your schedule. Pause, skip, or change your roast anytime.</p>",
            "width": "fit-content",
            "max_width": "narrow",
            "alignment": "center",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "text_color": "#FFFFFF",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        },
        "cta": {
          "type": "button",
          "settings": {
            "label": "Start a subscription",
            "link": "shopify://collections/all",
            "open_in_new_tab": false,
            "style_class": "button",
            "custom_button_background": "#FFFFFF",
            "custom_button_text": "#0F80C1",
            "width": "fit-content",
            "custom_width": 100,
            "width_mobile": "fit-content",
            "custom_width_mobile": 100
          }
        }
      },
      "block_order": ["heading", "body", "cta"],
      "settings": {
        "content_direction": "column",
        "horizontal_alignment": "center",
        "vertical_alignment": "center",
        "horizontal_alignment_flex_direction_column": "center",
        "vertical_alignment_flex_direction_column": "center",
        "gap": 20,
        "section_width": "page-width",
        "section_height": "small",
        "background_color": "#0F80C1",
        "padding-block-start": 96,
        "padding-block-end": 96
      }
    }
  },
  "order": ["hero_video", "punchy_statement", "brand_intro", "featured_products", "subscription_banner"]
}
