{%- doc -%}
  The hover strip that rides over a product card's image: roaster on the
  left, roast date on the right, both read from product metafields.

  The roaster arrives through the `coffee.roaster` metaobject rather than
  a text field, so the name here is the same string the product page and
  the roaster's own page use — it cannot drift into a second spelling.

  Rendered inside `.card-gallery`, which is already `position: relative`
  with `overflow: hidden` — so the strip can be absolutely positioned
  against the image and is clipped rather than spilling out of the card.

  Nothing renders when neither metafield is filled in, so cards for
  equipment or merch stay clean.

  @param {object} product - The product object
  @param {object} [block] - The block whose settings configure the strip
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings

  assign roaster = product.metafields.coffee.roaster.value.name.value
  if roaster != blank
    assign roaster = '(' | append: roaster | append: ')'
  endif

  assign roast_date_value = product.metafields.coffee.roast_date.value

  assign date_format = block_settings.card_meta_date_format | default: '%d %b %Y'
  assign roast_date = ''
  if roast_date_value != blank
    assign roast_date = roast_date_value | date: date_format
    if block_settings.card_meta_date_prefix != blank
      assign roast_date = block_settings.card_meta_date_prefix | append: ' ' | append: roast_date
    endif
  endif

  # Liquid has no operator precedence and evaluates right to left, so the
  # "enabled AND (either value present)" test is built up rather than
  # written as one mixed and/or expression.
  assign has_meta = false
  if roaster != blank or roast_date != blank
    assign has_meta = true
  endif
  if block_settings.show_card_meta == false
    assign has_meta = false
  endif
%}

{%- if has_meta -%}
  <product-card-meta
    class="card-meta"
    style="
      --card-meta-color: {{ block_settings.card_meta_color | default: '#ffffff' }};
    "
    aria-hidden="true"
  >
    <span class="card-meta__item">{{ roaster }}</span>
    <span class="card-meta__item">{{ roast_date }}</span>
  </product-card-meta>
{%- endif -%}

{% stylesheet %}
  /*
   * The strip is a full-width band pinned across the image with its two
   * items pushed to the edges. It stays invisible until the card is
   * hovered; JS then rides it up and down after the cursor.
   *
   * `bottom: 0` is the resting placement used when tracking is off (touch,
   * reduced motion). Once the element takes over it flips to `top: 0` and
   * drives position through `transform` instead.
   */
  .card-meta {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 2;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--padding-sm, 0.75rem);

    min-height: 2.75rem;
    padding-inline: 1rem;

    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: var(--ocp-text-size);
    line-height: var(--ocp-leading-snug);
    letter-spacing: var(--ocp-letter-spacing);
    text-transform: uppercase;
    color: var(--card-meta-color, #fff);

    /* Must never swallow the click that opens the product. */
    pointer-events: none;

    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .card-meta[data-tracking] {
    top: 0;
    bottom: auto;
    will-change: transform;
  }

  .card-meta__item {
    /* Long roaster names shouldn't wrap the band into two lines. */
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .card-meta__item:last-child {
    flex: 0 0 auto;
    text-align: end;
  }

  /*
   * The text had a scrim under it once — the photography is arbitrary and
   * white type needs something to sit against. It is gone: the card now takes
   * on the bag's own colour on hover, and that colour's lightness is held in a
   * band chosen so white reads against it. The surface the text needs is the
   * hover state itself, so dimming the image on top of it only muddied a
   * colour that had already been picked to work.
   */
  @media (hover: hover) and (pointer: fine) {
    .card-gallery:hover .card-meta {
      opacity: 1;
    }
  }

  /*
   * Without hover there is no way to reveal the band, so show it outright
   * rather than hiding the roaster and roast date from touch users.
   *
   * It also moves to the top of the image and stays there. Riding the cursor
   * is the whole reason it sits low on a mouse — there is no cursor here, and
   * a band parked across the bottom of the picture with nothing moving it
   * reads as something that failed to animate. At the top it reads as a
   * label, which is what it is.
   */
  @media (hover: none) {
    .card-meta {
      opacity: 1;
    }

    .card-gallery .card-meta,
    .card-gallery .card-meta[data-tracking] {
      top: 0;
      bottom: auto;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-meta {
      transition: none;
    }
  }
{% endstylesheet %}
