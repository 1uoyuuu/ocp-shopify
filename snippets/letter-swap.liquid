{% doc %}
  The site's one hover for clickable text: the words swap for copies of
  themselves arriving from below, all of them together.

  Rendered once from the layout. letter-swap.js decides which links take it
  and builds the letters; everything here is how they move.
{% enddoc %}

<script
  src="{{ 'letter-swap.js' | asset_url }}"
  type="module"
></script>

{% stylesheet %}
  /*
   * A word is a clipped box holding two copies of itself, one above the
   * other. Hovering slides the pair up by exactly one copy, so the second
   * arrives where the first was. Every word in a link moves together — the
   * whole label rolls over rather than rippling across.
   */
  .swap-word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;

    /* Whole words, so a line can only break between them and never inside
       one — which boxing each letter would otherwise allow. */
    white-space: nowrap;

    /*
     * Held to one line. Without a height `overflow: hidden` clips nothing —
     * the box simply grows to fit both copies, and the link comes out twice
     * as tall with the spare copy sitting in plain sight.
     *
     * `1em` is the fallback where `lh` is unsupported, and is exact at the
     * leading of 1 the display type runs at.
     */
    height: 1em;
    height: 1lh;

    /*
     * The clip box has to be a little taller than the line box or a
     * descender is shaved off at that leading. The padding gives that room
     * and the negative margin takes it back out of the layout, so the line
     * is exactly the height it was. content-box, because the theme sets
     * border-box globally and the height above is meant to be the word, not
     * the word minus the room just made for it.
     */
    --swap-bleed: 0.18em;
    box-sizing: content-box;
    padding-block: var(--swap-bleed);
    margin-block: calc(var(--swap-bleed) * -1);
  }

  .swap-word__inner {
    display: block;
    transition: transform 0.36s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .swap-word__face {
    display: block;
  }

  /*
   * Pushed down by the full bleed so it waits outside the clip box rather
   * than peeking into the room the padding just opened up.
   */
  .swap-word__face--ghost {
    margin-block-start: calc(var(--swap-bleed) * 2);
  }

  /*
   * Half the pair plus that gap is exactly one word's worth of travel, so the
   * copy lands where the original stood rather than near it.
   */
  [data-swap-host]:hover .swap-word__inner,
  [data-swap-host]:focus-visible .swap-word__inner {
    transform: translateY(calc(-50% - var(--swap-bleed)));
  }

  /*
   * The menu panel's links clip their own text for the ellipsis a very long
   * label would need. That clip sits a hair tighter than the swap's, so it
   * would shave the tops off the words on their way past. The word box does
   * the clipping here; the ellipsis is left to the rare label that needs it.
   */
  .menu-drawer .menu-drawer__menu-item-text:has(.swap-word) {
    overflow: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .swap-word__inner {
      transition: none;
    }
  }
{% endstylesheet %}
